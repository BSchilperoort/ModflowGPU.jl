# ex-gwf-fhb CHD with the CHDHEAD time series (ex-gwf-fhb.chd.ts) replaced by its
# breakpoint values, one constant per stress period.
BEGIN options
END options

BEGIN dimensions
  MAXBOUND  3
END dimensions

BEGIN period  1
  1 1 10 0.0
  1 2 10 0.0
  1 3 10 0.0
END period  1

BEGIN period  2
  1 1 10 1.0
  1 2 10 1.0
  1 3 10 1.0
END period  2

BEGIN period  3
  1 1 10 5.0
  1 2 10 5.0
  1 3 10 5.0
END period  3
