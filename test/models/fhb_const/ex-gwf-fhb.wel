# ex-gwf-fhb WEL with the FLOWRATE time series (ex-gwf-fhb.wel.ts) replaced by its
# breakpoint values, one constant per stress period.
BEGIN options
END options

BEGIN dimensions
  MAXBOUND  1
END dimensions

BEGIN period  1
  1 2 1 2000.0
END period  1

BEGIN period  2
  1 2 1 6000.0
END period  2

BEGIN period  3
  1 2 1 5000.0
END period  3
