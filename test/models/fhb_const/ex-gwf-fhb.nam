# ex-gwf-fhb (MF6 examples) without OBS; CHD and WEL time series replaced by constants.
BEGIN options
  SAVE_FLOWS
END options

BEGIN packages
  DIS6  ex-gwf-fhb.dis  dis
  NPF6  ex-gwf-fhb.npf  npf
  IC6  ex-gwf-fhb.ic  ic
  STO6  ex-gwf-fhb.sto  sto
  CHD6  ex-gwf-fhb.chd  chd
  WEL6  ex-gwf-fhb.wel  wel
  OC6  ex-gwf-fhb.oc  oc
END packages
