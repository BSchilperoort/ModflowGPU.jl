# Rates from a LINEAREND series, the AUXMULTNAME multiplier from a STEPWISE series.
BEGIN options
  AUXILIARY  mult
  AUXMULTNAME  mult
  BOUNDNAMES
  TS6  FILEIN  tsm.wel.ts
END options

BEGIN dimensions
  MAXBOUND  3
END dimensions

BEGIN period  1
  1 3 5 q_end mult well1
  1 2 8 -800.0 mult
  1 4 6 q_end 0.75 well2
END period  1

BEGIN period  3
  1 3 5 -1500.0 mult well1
END period  3
