# Heads from two series of one TS6 file (LINEAR and STEPWISE, SFACS, a DNODATA value).
BEGIN options
  TS6  FILEIN  tsm.chd.ts
END options

BEGIN dimensions
  MAXBOUND  5
END dimensions

BEGIN period  1
  1 1 1 chd_a
  1 2 1 chd_a
  1 3 1 CHD_A
  1 4 1 chd_b
  1 5 1 chd_b
END period  1

BEGIN period  3
  1 1 1 chd_a
  1 2 1 1.5
  1 3 1 1.5
  1 4 1 chd_b
  1 5 1 1.5
END period  3
