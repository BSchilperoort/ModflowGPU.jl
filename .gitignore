# Reference toolchain, MF6 sources, example inputs, reference runs and the
# Modflow-coupling clone (validation/fetch_reference.sh). Never commit these.
reference/

# Benchmark output (results worth keeping go in benchmark/results/*.md)
benchmark/out/

tmp/

# Claude Code worktrees and local settings (the rest of .claude/ may be committed)
.claude/worktrees/
.claude/settings.local.json

graphify-out/

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# File generated by Pkg, the package manager, based on a corresponding Project.toml.
# As in mGV, it is not committed for a package. With the workspace, the single
# Manifest.toml at the root also covers test/.
Manifest.toml
Manifest-v*.toml

# Ignore VSCode or JetBrains project files
.vscode/
.idea/

# Figures made at docs build time (docs/performance_figures.jl)
docs/src/assets/performance_*.svg
