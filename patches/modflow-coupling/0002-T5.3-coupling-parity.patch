@@ -0,0 +1,161 @@
+#=
+Coupling parity on the Indus (ModflowGPU T5.3; ModflowGPU PLAN.md section 4, row
+"Coupling"): the GPU engine against the mf6 engine, both with tight solver settings,
+over 1979-01 to 1979-03 in monthly periods and 1979-01-01 to 1979-01-31 in daily
+periods, with the GPU engine in each precision (`MODFLOWCOUPLING_PRECISIONS`, default
+single, mixed, double) on the backend `MODFLOWCOUPLING_BACKEND` (runtests.jl).
+
+Pass criteria (tight closures, every period):
+- `:double` and `:mixed`: heads < 1e-4 m; `baseflow_to_routing` and `capillary_rise`
+  < 1e-6 relative to their domain maximum (max over land cells of |mf6 value| in the
+  period).
+- `:single`: heads < 1e-3 m; baseflow and capillary rise < 1e-4 × domain maximum.
+
+The differences at the production settings of indus.toml (`outer_dvclose = 5`) are
+logged, not tested (the engines stop at different points, see the closure table).
+
+`MODFLOWCOUPLING_CLOSURE_TABLE=1` also runs the closure study: for each engine and
+`outer_dvclose` = 5, 0.5 and 0.01 (`inner_dvclose` equal to it, the other settings of
+indus.toml), the distance to the engine's own tight heads (max over the periods) and the
+median wall time of a period (`BMI.update`), monthly and daily, after a warm-up run. It prints a Markdown table.
+
+Run alone: `Pkg.test(test_args = ["parity"])` or `MODFLOWCOUPLING_TESTS=parity`.
+=#
+
+const PARITY_PRECISIONS = split(get(ENV, "MODFLOWCOUPLING_PRECISIONS", "single,mixed,double"), ",")
+
+"""
+Tight closures of PLAN.md section 4 for both engines, except INNER_RCLOSE (absolute,
+m3/day, `rclose_option = :strict`): MF6 does not converge on the Indus with 1e-10 (its
+residual does not get below the rounding level of the large RIV and DRN terms), and
+1e-8 is the tightest power of ten measured to converge. The GPU engine raises the
+closures to its Float32 floors in `:single` (ModflowGPU `FLOAT32_CLOSURES`).
+"""
+const TIGHT = MC.SolverSettings(; outer_dvclose = 1e-9, inner_dvclose = 1e-10, inner_rclose = 1e-8,
+                                outer_maximum = 500, inner_maximum = 2000)
+
+"Discharge fraction of period `k`: the monthly forcing, repeated over the days."
+period_fraction(k) = FORCING[mod1(k, length(FORCING))]
+
+"Outputs of one run, one entry per period."
+struct ParityRun
+    heads::Vector{Array{Float64,3}}
+    baseflow::Vector{Matrix{Float64}}
+    capillary::Vector{Matrix{Float64}}
+    seconds::Vector{Float64}          # wall time of each BMI.update
+    iterations::Vector{Tuple{Int,Int}} # (outer, inner) per period, GPU engine only
+end
+
+"""
+    parity_run(dir, period, solver) -> ParityRun
+
+Run the Indus model with `period = "month"` (1979-01 to 1979-03) or `"day"` (1979-01-01
+to 1979-01-31) and solver settings `solver` (engine, precision, closures), forced as in
+runtests.jl (`force!`).
+"""
+function parity_run(dir, period, solver)
+    stop = period == "day" ? Date(1979, 1, 31) : Date(1979, 3, 31)
+    cfg = test_config(dir; period, stop, write_monthly_output = false, solver)
+    m = GroundwaterModel(cfg)
+    r = ParityRun([], [], [], [], [])
+    try
+        for k in eachindex(m.periods)
+            force!(m, period_fraction(k))
+            push!(r.seconds, @elapsed BMI.update(m))
+            push!(r.heads, copy(m.head))
+            push!(r.baseflow, copy(m.baseflow))
+            push!(r.capillary, copy(m.capillary))
+            if m.mf isa MC.ModflowGPU.Simulation
+                o = m.mf.results[end].outer
+                push!(r.iterations, (o.iterations, o.inner))
+            end
+        end
+    finally
+        BMI.finalize(m)   # also after an error, so libmf6 is free for the next run
+    end
+    return r
+end
+
+"Max |a - b| over the active cells of both layers, over all periods."
+head_difference(a::ParityRun, b::ParityRun, active) =
+    maximum(maximum(abs.(x .- y)[active]) for (x, y) in zip(a.heads, b.heads))
+
+"Max over the periods of max |a - b| / max |b| over the land cells (b is the reference)."
+function relative_difference(a, b, land)
+    maximum(zip(a, b)) do (x, y)
+        scale = maximum(abs, y[land])
+        d = maximum(abs.(x .- y)[land])
+        scale > 0 ? d / scale : d
+    end
+end
+
+"`(heads, baseflow, capillary)` differences of `a` against the reference `b`."
+parity_differences(a, b, active, land) =
+    (head_difference(a, b, active), relative_difference(a.baseflow, b.baseflow, land),
+     relative_difference(a.capillary, b.capillary, land))
+
+"Section 4 coupling tolerances: (heads in m, baseflow and capillary rise relative to the domain maximum)."
+coupling_tolerance(precision) = precision == "single" ? (1e-3, 1e-4) : (1e-4, 1e-6)
+
+fmt(x) = string(round(x; sigdigits = 2))
+
+@testset "Coupling parity (T5.3, backend $BACKEND)" begin
+    tmp = mktempdir()
+    s = read_static_inputs(test_config(tmp))
+    active = cat(s.idomain .> 0, s.idomain .> 0; dims = 3)
+    land = s.landmask
+    for period in ("month", "day")
+        @testset "period = $period" begin
+            dir(name) = joinpath(tmp, "$(period)_$name")
+            tight_mf6 = parity_run(dir("tight_mf6"), period, with_engine(TIGHT, "mf6"))
+            prod_mf6 = parity_run(dir("prod_mf6"), period, with_engine(INDUS.solver, "mf6"))
+            @info "mf6, $period: production heads within $(fmt(head_difference(prod_mf6, tight_mf6, active))) m of the tight heads"
+            for precision in PARITY_PRECISIONS
+                @testset "gpu $precision" begin
+                    tight = parity_run(dir("tight_gpu_$precision"), period, with_engine(TIGHT, "gpu"; precision))
+                    dh, dbf, dcap = parity_differences(tight, tight_mf6, active, land)
+                    outer, inner = sum(first, tight.iterations), sum(last, tight.iterations)
+                    @info "gpu $precision vs mf6, $period, tight closures: max |Δh| = $(fmt(dh)) m, " *
+                          "baseflow $(fmt(dbf)), capillary rise $(fmt(dcap)) (× domain max); " *
+                          "$outer outer / $inner inner iterations over $(length(tight.heads)) periods"
+                    htol, ftol = coupling_tolerance(precision)
+                    @test dh < htol
+                    @test dbf < ftol
+                    @test dcap < ftol
+
+                    prod = parity_run(dir("prod_gpu_$precision"), period, with_engine(INDUS.solver, "gpu"; precision))
+                    ph, pbf, pcap = parity_differences(prod, prod_mf6, active, land)
+                    @info "gpu $precision vs mf6, $period, production closures: max |Δh| = $(fmt(ph)) m, " *
+                          "baseflow $(fmt(pbf)), capillary rise $(fmt(pcap)) (× domain max); " *
+                          "gpu production heads within $(fmt(head_difference(prod, tight, active))) m of its tight heads"
+                end
+            end
+        end
+    end
+
+    if get(ENV, "MODFLOWCOUPLING_CLOSURE_TABLE", "0") == "1"
+        rows = String[]
+        engines = [("mf6", "")]
+        append!(engines, [("gpu", p) for p in PARITY_PRECISIONS])
+        for (engine, precision) in engines
+            label = engine == "mf6" ? "mf6" : "gpu $precision ($BACKEND)"
+            kw = engine == "gpu" ? (; precision) : (;)
+            cells = String[]
+            for period in ("month", "day")
+                dir(name) = joinpath(tmp, "closure_$(engine)$(precision)_$(period)_$name")
+                parity_run(dir("warmup"), period, with_engine(INDUS.solver, engine; kw...))   # compile
+                tight = parity_run(dir("tight"), period, with_engine(TIGHT, engine; kw...))
+                push!(cells, "$(fmt(median(tight.seconds))) s")
+                for dvclose in (5.0, 0.5, 0.01)
+                    r = parity_run(dir("dv$dvclose"), period,
+                                   with_engine(INDUS.solver, engine; outer_dvclose = dvclose, inner_dvclose = dvclose, kw...))
+                    push!(cells, "$(fmt(head_difference(r, tight, active))) m, $(fmt(median(r.seconds))) s")
+                end
+            end
+            push!(rows, "| $label | " * join(cells, " | ") * " |")
+        end
+        header = "| engine | monthly tight | monthly 5 | monthly 0.5 | monthly 0.01 | daily tight | daily 5 | daily 0.5 | daily 0.01 |\n" *
+                 "| --- | --- | --- | --- | --- | --- | --- | --- | --- |"
+        println("\nClosure table (distance to the tight heads, median wall time per period):\n", header, "\n", join(rows, "\n"))
+    end
+end
