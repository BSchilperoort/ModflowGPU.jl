+++ b/src/gpu_engine.jl
@@ -0,0 +1,108 @@
+#=
+The GPU engine (`[solver] engine = "gpu"`): the same MODFLOW model as `mf6_writer.jl`,
+built in memory with ModflowGPU's builder API and run through its libmf6-like stepping
+API (`ModflowGPU.initialize`, `prepare_time_step`, ... ; `get_value_ptr` addresses as
+libmf6's). No MF6 input files are written. Differences from the mf6 engine:
+
+- RCH rates are stored per unit area (as MF6 >= 6.4); MF6 6.3's multiplication by the
+  cell area on reading does not apply, so `rch_scale` is 1 (`calibrate_bmi!`).
+- `get_value_ptr` returns host Float64 mirrors with absolute heads. ModflowGPU keeps
+  heads as offsets from `"<model>/HREF"` on the device; river stages written into the
+  RIV BOUND mirror are converted to offsets in Float64 when they are sent to the device
+  (at `prepare_solve`, as `set_value` does).
+- Several GPU models can be active at a time (no libmf6 instance).
+=#
+
+"""
+    build_spec(config, inputs, params, periods) -> ModflowGPU.SimulationSpec
+
+The model of `write_simulation` as a ModflowGPU `SimulationSpec` (builder API): the same
+packages, options, records and record order. The spec is identical to the one ModflowGPU
+loads from the files `write_simulation` writes (tested).
+"""
+function build_spec(config::Config, s::StaticInputs, p::StaticParameters, periods::Vector{Date})
+    G = ModflowGPU
+    name = config.model_name
+    base = lowercase(name)
+    sv = config.solver
+    save = config.save_mf6_binary
+
+    dis = G.build_dis(; delr = s.delr, delc = s.delc, top = p.top, botm = p.botm,
+                      idomain = cat(s.idomain, s.idomain; dims = 3), length_units = :meters, nogrb = true)
+    npf = G.build_npf(dis; icelltype = 0, k = p.k, k33 = p.k33)
+    sto = G.build_sto(dis; iconvert = 0, ss = p.ss, storagecoefficient = true,
+                      periods = [1 => (config.period == "steady" ? :steady_state : :transient)])
+    ic = G.build_ic(dis; strt = p.initial_head)
+
+    nchd = length(p.chd_cells)
+    rec(cells; layer = 1) = (; cells = cells, layer = layer)
+    chd = G.build_boundary(:CHD, dis; name = "CHD", save_flows = save,
+                           periods = [1 => (; rec(vcat(p.chd_cells, p.chd_cells); layer = vcat(fill(1, nchd), fill(2, nchd)))...,
+                                           values = vec(p.chd_head))])
+    # Placeholder rate 1.0 as in the written input (`calibrate_bmi!` checks it).
+    rch = G.build_boundary(:RCH, dis; name = "RCH", save_flows = save,
+                           periods = [1 => (; rec(p.rch_cells)..., values = ones(length(p.rch_cells)))])
+    r = p.river
+    stage0 = [river_stage(r, i, 0.0) for i in eachindex(r.cells)]
+    riv = G.build_boundary(:RIV, dis; name = "RIV", save_flows = save,
+                           periods = [1 => (; rec(r.cells)..., values = hcat(stage0, r.conductance, r.bottom))])
+    d = p.drain
+    drn = G.build_boundary(:DRN, dis; name = "DRN", save_flows = save,
+                           periods = [1 => (; rec(d.cells)..., values = hcat(d.elevation, d.conductance))])
+    boundaries = [chd, rch, riv, drn]
+    if config.foc
+        push!(boundaries, G.build_boundary(:EVT, dis; name = "EVT", fixed_cell = true, save_flows = save,
+                                           periods = [1 => (; rec(p.evt_cells)..., values = hcat(p.evt_surface, p.evt_rate, p.evt_depth))]))
+    end
+    if config.pumping
+        push!(boundaries, G.build_boundary(:WEL, dis; name = "WEL", save_flows = save,
+                                           periods = [1 => (; rec(p.wel_cells)..., values = zeros(length(p.wel_cells)))]))
+    end
+    oc = G.build_oc(; head_file = save ? "$base.hds" : "", budget_file = save ? "$base.cbc" : "",
+                    periods = [1 => (save ? ["PRINT BUDGET ALL", "SAVE HEAD ALL", "SAVE BUDGET ALL"] : ["PRINT BUDGET ALL"])])
+    model = G.build_model(name; dis, npf, ic, sto, oc, boundaries)
+    tdis = G.build_tdis(; perlen = [Float64(period_days(config, d)) for d in periods], nstp = 1, tsmult = 1.0,
+                        time_units = :days)
+    ims = G.build_ims(; complexity = :complex, print_option = :summary,
+                      outer_dvclose = sv.outer_dvclose, outer_maximum = sv.outer_maximum,
+                      under_relaxation = :simple, under_relaxation_gamma = sv.under_relaxation_gamma,
+                      inner_maximum = sv.inner_maximum, inner_dvclose = sv.inner_dvclose,
+                      inner_rclose = sv.inner_rclose, rclose_option = :strict,
+                      linear_acceleration = :bicgstab, relaxation_factor = sv.relaxation_factor)
+    return G.build_simulation(model; tdis, ims, simdir = config.work_dir)
+end
+
+"Build and initialize the ModflowGPU simulation of `m` (the GPU engine)."
+function initialize_gpu(m)
+    c = m.config
+    sv = c.solver
+    spec = build_spec(c, m.inputs, m.params, m.periods)
+    mkpath(c.work_dir)
+    return ModflowGPU.initialize(spec; backend = ModflowGPU.select_backend(sv.backend),
+                                 precision = Symbol(sv.precision), preconditioner = Symbol(sv.preconditioner),
+                                 outdir = c.work_dir, write_output = true)
+end
+
+# The stepping calls of both engines (libmf6 through ModflowInterface, or ModflowGPU).
+const GpuSimulation = ModflowGPU.Simulation
+
+engine_pointer(mf::ModflowModel, component, var; sub = "") =
+    BMI.get_value_ptr(mf, MF.get_var_address(mf, var, component; subcomponent_name = sub))
+engine_pointer(sim::GpuSimulation, component, var; sub = "") =
+    ModflowGPU.get_value_ptr(sim, join(filter(!isempty, [component, sub, var]), "/"))
+
+engine_prepare_time_step(mf::ModflowModel) = MF.prepare_time_step(mf, 0.0)
+engine_prepare_time_step(sim::GpuSimulation) = ModflowGPU.prepare_time_step(sim)
+engine_prepare_solve(mf::ModflowModel) = MF.prepare_solve(mf)
+engine_prepare_solve(sim::GpuSimulation) = ModflowGPU.prepare_solve(sim)
+engine_solve(mf::ModflowModel) = MF.solve(mf)
+engine_solve(sim::GpuSimulation) = ModflowGPU.solve(sim)
+"Whether the outer iterations stopped early without converging (ModflowGPU only)."
+engine_diverged(::ModflowModel) = false
+engine_diverged(sim::GpuSimulation) = sim.outer.diverged
+engine_finalize_solve(mf::ModflowModel) = MF.finalize_solve(mf)
+engine_finalize_solve(sim::GpuSimulation) = ModflowGPU.finalize_solve(sim)
+engine_finalize_time_step(mf::ModflowModel) = MF.finalize_time_step(mf)
+engine_finalize_time_step(sim::GpuSimulation) = ModflowGPU.finalize_time_step(sim)
+engine_finalize(mf::ModflowModel) = BMI.finalize(mf)
+engine_finalize(sim::GpuSimulation) = ModflowGPU.finalize(sim)
