index 0000000..10c93cb
--- /dev/null
+++ b/examples/global/check_inputs.jl
@@ -0,0 +1,164 @@
+#= Checks of the global MODFLOW and mGV inputs before a coupled global run (ModflowGPU
+card T5.5a, for T5.5b). Reads only; prints a report (README.md next to this file has the
+results of 2026-11-14).
+
+    julia --project=examples/mgv_coupling examples/global/check_inputs.jl \
+        examples/global/global.toml <mgv_param.nc> <mgv_forcing.zarr> [<routing.nc>]
+
+1. The MODFLOW inputs of the config: read through ModflowCoupling (every file's
+   coordinates within 1e-3 degrees of the ibound grid), the parameters built, the
+   static audit, records per package and duplicate records per cell (DRN, RIV, EVT:
+   the device coupling allows one record per cell and package).
+2. The file variants: `_nogl` against the original domain, capillary rise v2 against
+   v3, the v2clamped Z0 and min_dem, the CHD heads of the steady-head file.
+3. The grids of MODFLOW, the mGV parameters, the forcing and the routing file: the
+   same coordinates, and which active cells of each model the other lacks.
+=#
+using ModflowCoupling, NCDatasets, Printf, Statistics
+import ModflowCoupling as MC
+import mGV
+
+length(ARGS) >= 3 || error("usage: check_inputs.jl <global.toml> <mgv_param.nc> <mgv_forcing.zarr> [<routing.nc>]")
+config_path, param_path, forcing_path = ARGS[1:3]
+routing_path = get(ARGS, 4, "")
+
+section(title) = println("\n== ", title)
+pct(a, b) = @sprintf("%.2f %%", 100 * a / b)
+
+config = load_config(config_path)
+section("MODFLOW inputs ($(config_path))")
+t = @elapsed s = read_static_inputs(config)
+@printf("read in %.0f s: grid %d x %d, lon %.4f .. %.4f, lat %.4f .. %.4f, DELR %.1f m\n", t, size(s)..., s.lon[1], s.lon[end],
+        s.lat[1], s.lat[end], s.delr)
+idcount = Dict(v => count(==(v), s.idomain) for v in unique(s.idomain))
+println("idomain counts: ", sort(collect(idcount)), "; landmask ", count(s.landmask))
+active = s.idomain .> 0
+println("active cells not on land: ", count(active .& .!s.landmask), " (idomain 2: ", count((s.idomain .== 2) .& s.landmask), " on land)")
+for f in (:dem, :aqdepth, :cell_area, :ksat_log, :spe_yi, :qbank, :riv_slope, :min_dem, :z0_floodplain, :kq3, :catchment,
+          :cpsurface, :cprate, :cpdistinct)
+    a = getfield(s, f)
+    land = s.landmask .& active
+    @printf("  %-15s finite on %8d of %d active land cells (%s missing)\n", f, count(isfinite, a[land]), count(land),
+            pct(count(!isfinite, a[land]), count(land)))
+end
+for l in 1:2
+    h = s.steady_head[:, :, l]
+    @printf("  steady_head layer %d: finite on %d of %d land cells, on %d of %d CHD cells\n", l, count(isfinite, h[s.landmask .& active]),
+            count(s.landmask .& active), count(isfinite, h[s.idomain .== 2]), count(==(2), s.idomain))
+end
+
+p = try
+    build_parameters(s, config)
+catch err
+    println("build_parameters FAILED: ", sprint(showerror, err))
+    # The CHD ring lies in the ocean: with heads at sea level the rest can be checked.
+    chd = (s.idomain .== 2) .& .!isfinite.(s.steady_head[:, :, 1])
+    println("  retrying with sea level (0 m) on the $(count(chd)) CHD cells without a head")
+    h = copy(s.steady_head)
+    for l in 1:2
+        view(h, :, :, l)[chd] .= 0.0
+    end
+    global s = MC.StaticInputs((getfield(s, f) for f in fieldnames(MC.StaticInputs)[1:(end - 1)])..., h)
+    build_parameters(s, config)
+end
+section("Packages")
+nland = count(s.landmask .& active)
+for (name, cells) in (("CHD (per layer)", p.chd_cells), ("RCH", p.rch_cells), ("RIV", p.river.cells), ("DRN", p.drain.cells),
+                      ("EVT", p.evt_cells))
+    dup = length(cells) - length(unique(cells))
+    @printf("  %-15s %8d records, %d duplicate cells\n", name, length(cells), dup)
+end
+@printf("  RIV with width > 30 m (river conductance): %d; drain-like: %d\n", count(p.river.is_river), count(.!p.river.is_river))
+@printf("  model nodes (2 layers): %d\n", 2 * count(active))
+for (name, ok) in audit_static_inputs(s, p, config)
+    println("  audit: ", ok ? "pass" : "FAIL", "  ", name)
+end
+
+section("File variants")
+gd = config.data_dir
+readvar(file, var = nothing) = NCDataset(joinpath(gd, file)) do ds
+    v = var === nothing ? only(k for k in keys(ds) if ndims(ds[k]) >= 2) : var
+    MC.to_float.(ds[v][:, :, ntuple(_ -> 1, ndims(ds[v]) - 2)...])
+end
+ib_old, ib_new = readvar("ibound_oc.nc"), readvar("ibound_oc_nogl.nc")
+lm_old, lm_new = readvar("landmask_oc.nc"), readvar("landmask_oc_nogl.nc")
+@printf("ibound active: original %d, nogl %d; nogl ⊂ original: %s\n", count(>(0), ib_old), count(>(0), ib_new),
+        all(ib_old[ib_new .> 0] .> 0))
+removed = (ib_old .== 1) .& .!(ib_new .== 1)
+rem = findall(removed)
+@printf("cells removed by nogl: %d, lon %.2f .. %.2f, lat %.2f .. %.2f\n", length(rem), extrema(s.lon[[c[1] for c in rem]])...,
+        extrema(s.lat[[c[2] for c in rem]])...)
+@printf("landmask: original %d, nogl %d\n", count(x -> isfinite(x) && x != 0, lm_old), count(x -> isfinite(x) && x != 0, lm_new))
+v2 = readvar("capillary_rise_oc_v2.nc", "cprate")
+v3 = readvar("capillary_rise_oc_v3.nc", "cprate")
+phys = readvar("capillary_rise_oc_v3.nc", "cprate_physical")
+area = readvar("cell_area_oc.nc")
+both = isfinite.(v2) .& isfinite.(v3) .& (v2 .!= 0)
+ratio = v3[both] ./ v2[both]
+factor = (area ./ (s.delr * s.delc))[both]
+@printf("capillary v3/v2 cprate: median %.4f; max |v3/v2 - cell_area/(DELR*DELC)| = %.2e; v3 cprate_physical == v2 cprate: %s\n",
+        median(ratio), maximum(abs.(ratio .- factor)), isequal(phys[both], v2[both]))
+for name in ("cpsurface", "cpdistinct")
+    @printf("capillary v2 vs v3 %s identical: %s\n", name, isequal(readvar("capillary_rise_oc_v2.nc", name), readvar("capillary_rise_oc_v3.nc", name)))
+end
+for (new, old) in (("Z0_floodplain_oc_v2clamped.nc", "Z0_floodplain_oc.nc"), ("min_dem_oc_v2clamped.nc", "min_dem_oc.nc"))
+    a, b = readvar(new), readvar(old)
+    m = (ib_new .== 1) .& isfinite.(a) .& isfinite.(b)
+    @printf("%s - %s on nogl land: median %.1f m, p95 |.| %.1f m; finite on nogl land: %d / %d\n", new, old,
+            median(a[m] .- b[m]), quantile(abs.(a[m] .- b[m]), 0.95), count(isfinite, a[ib_new .== 1]), count(==(1), ib_new))
+end
+q_old, q_new = readvar("bankfull_discharge_1979_2010_vicwur5min.nc"), readvar("qbank_daily_1979_2019_natpcv_gwm_v1.nc")
+m = (ib_new .== 1) .& isfinite.(q_old) .& isfinite.(q_new) .& (q_old .> 0)
+@printf("qbank new/old on nogl land: median %.2f\n", median(q_new[m] ./ q_old[m]))
+for file in ("initial_head_gv2p41_5min_nogl.nc", "daily_bankfull_mf_ss_gwl_5minDRN.nc")
+    NCDataset(joinpath(gd, file)) do ds
+        h = MC.to_float.(ds["gwl"][:, :, 1])
+        @printf("%s layer 1: finite on %d of %d nogl CHD cells (values there: %s), %d of %d nogl land cells\n", file,
+                count(isfinite, h[ib_new .== 2]), count(==(2), ib_new),
+                count(isfinite, h[ib_new .== 2]) > 0 ? @sprintf("%.1f .. %.1f m", extrema(filter(isfinite, h[ib_new .== 2]))...) : "-",
+                count(isfinite, h[ib_new .== 1]), count(==(1), ib_new))
+    end
+end
+
+section("Grids")
+coords(path, lon = "lon", lat = "lat") = NCDataset(path) do ds
+    Float64.(ds[lon][:]), Float64.(ds[lat][:])
+end
+plon, plat = coords(param_path)
+run_cell = NCDataset(ds -> Array(ds["run_cell"][:, :]), param_path)
+mgv_active = map(x -> !ismissing(x) && x > 0, run_cell)
+@printf("mGV parameters: %d x %d, max |Δlon| %.2e, max |Δlat| %.2e against MODFLOW; %d active cells\n", length(plon), length(plat),
+        maximum(abs.(plon .- s.lon)), maximum(abs.(plat .- s.lat)), count(mgv_active))
+mf_active = s.idomain .== 1
+@printf("  mGV active, not MODFLOW land (idomain 1): %d (of which idomain 2: %d, idomain 0: %d)\n", count(mgv_active .& .!mf_active),
+        count(mgv_active .& (s.idomain .== 2)), count(mgv_active .& (s.idomain .== 0)))
+ex = findall(mgv_active .& .!mf_active)
+isempty(ex) || @printf("    their extent: lon %.2f .. %.2f, lat %.2f .. %.2f; in the nogl removal: %d\n",
+                       extrema(s.lon[[c[1] for c in ex]])..., extrema(s.lat[[c[2] for c in ex]])..., count(removed[ex]))
+@printf("  MODFLOW land, not mGV active: %d\n", count(mf_active .& .!mgv_active))
+
+z = mGV.Zarr.zopen(forcing_path)
+flon, flat = Float64.(z["lon"][:]), Float64.(z["lat"][:])
+@printf("forcing %s: %d x %d, max |Δlon| %.2e, max |Δlat| %.2e against the parameters; variables %s\n", basename(forcing_path),
+        length(flon), length(flat), maximum(abs.(flon .- plon)), maximum(abs.(flat .- plat)), join(sort(collect(keys(z.arrays))), ", "))
+if haskey(z.arrays, "lon_index")
+    idx = Int.(z["lon_index"][:]) .+ 1 .+ Int.(z["lat_index"][:]) .* length(flon)
+    have = falses(size(mgv_active))
+    have[idx] .= true
+    @printf("  land-only store: %d cells (%d unique); mGV active cells without forcing: %d; forcing cells not mGV active: %d\n",
+            length(idx), length(unique(idx)), count(mgv_active .& .!have), count(have .& .!mgv_active))
+    t = z["time"]
+    @printf("  time: %d steps, %s\n", length(t), get(t.attrs, "units", "?"))
+end
+
+if !isempty(routing_path)
+    rlon, rlat = coords(routing_path)
+    ids = NCDataset(ds -> Array(ds["downstream_id"][:, :]), routing_path)
+    valid = map(x -> !ismissing(x) && x > 0, ids)
+    @printf("routing %s: %d x %d, max |Δlon| %.2e, max |Δlat| %.2e against the parameters; %d network cells\n", basename(routing_path),
+            length(rlon), length(rlat), maximum(abs.(rlon .- plon)), maximum(abs.(rlat .- plat)), count(valid))
+    @printf("  mGV active cells without a routing cell: %d; routing cells not mGV active: %d\n",
+            count(mgv_active .& .!valid), count(valid .& .!mgv_active))
+    miss = findall(mgv_active .& .!valid)
+    isempty(miss) || @printf("    their latitude range: %.2f .. %.2f\n", extrema(plat[[c[2] for c in miss]])...)
+end
