diff --git a/examples/mgv_coupling/global_rehearsal.jl b/examples/mgv_coupling/global_rehearsal.jl
new file mode 100644
index 0000000..b982633
--- /dev/null
+++ b/examples/mgv_coupling/global_rehearsal.jl
@@ -0,0 +1,302 @@
+#= Global-size dress rehearsal (ModflowGPU card T5.5a).
+
+How to run (both models on one GPU; see README.md, "Global dress rehearsal"):
+    MGV_BACKEND=rocm julia -t 8 --project=examples/mgv_coupling \
+        examples/mgv_coupling/global_rehearsal.jl <mgv_config.toml|none> <outdir> [key=value ...]
+
+MODFLOW is the synthetic `global5m` model of ModflowGPU (benchmark/synthetic.jl, T3.4:
+4320 × 2160 cells, 35 % land) put through ModflowCoupling's parameter transformations and
+GPU engine, built from arrays (`StaticInputs`, `GroundwaterModel(config, inputs)`; no
+NetCDF). Its grid is the global 5′ grid (cell centres -179.958 … 179.958 E, -89.958 …
+89.958 N), so the cells of mGV's global parameter grid (84 N to 56 S) map onto it by
+centre. The land masks of the two models differ (synthetic against real): the exchange
+runs on every overlapping cell, but the fields mean nothing physically. The run measures
+memory and time. MODFLOW takes mGV's recharge, but a synthetic river discharge (see the
+daily loop); mGV takes MODFLOW's baseflow and capillary rise.
+
+Sequence: mGV is initialized first (with `mgv_config`; `none` runs MODFLOW alone with
+synthetic forcing), then the MODFLOW steady-state spin-up (`period = "steady"`, synthetic
+mean recharge and 0.3 × bankfull discharge), whose model is finalized (its device memory
+freed) before the daily model is built from the spin-up heads; then `days` coupled days
+(mGV day D, MODFLOW day D, feedback for D+1, as `step_day_device!` in coupling.jl, with
+the two parts timed separately).
+
+Keys (defaults): precision=auto, dvclose=0.01 (outer and inner, daily and spin-up),
+days=365, steady_precond=auto (spin-up preconditioner), precond=auto (daily),
+steady_dvclose=dvclose, steady_gamma=0.5 and steady_outer=2000 (as spinup_steady_state.jl).
+
+Writes `<outdir>/days.csv` (per day: total, mGV and MODFLOW seconds, outer and inner
+iterations), `<outdir>/summary.toml` (memory and times) and `<outdir>/head_final.bin` (the
+layer-1 heads after the last day, Float64, for comparing closures; `head_steady.bin` those
+of the spin-up).
+=#
+const GPU_PACKAGE = get(ENV, "COUPLING_GPU_PACKAGE", "AMDGPU")
+isempty(GPU_PACKAGE) || @eval using $(Symbol(GPU_PACKAGE))
+include(joinpath(@__DIR__, "coupling.jl"))
+using TOML, Statistics
+import ModflowGPU
+include(joinpath(pkgdir(ModflowGPU), "benchmark", "synthetic.jl"))
+using .SyntheticModels: synthetic_fields
+
+const ARGV = ARGS
+length(ARGV) >= 2 || error("usage: global_rehearsal.jl <mgv_config.toml|none> <outdir> [key=value ...]")
+const MGV_CONFIG = ARGV[1] == "none" ? "" : abspath(ARGV[1])
+const OUTDIR = abspath(ARGV[2])
+const OPTS = Dict(split(a, "="; limit = 2)[1] => split(a, "="; limit = 2)[2] for a in ARGV[3:end])
+opt(k, default) = get(OPTS, k, string(default))
+const PRECISION = opt("precision", "auto")
+const DVCLOSE = parse(Float64, opt("dvclose", 0.01))
+const STEADY_DVCLOSE = parse(Float64, opt("steady_dvclose", DVCLOSE))
+const NDAYS = parse(Int, opt("days", 365))
+const STEADY_PRECOND = opt("steady_precond", "auto")
+const PRECOND = opt("precond", "auto")
+const STEADY_GAMMA = parse(Float64, opt("steady_gamma", 0.5))
+const STEADY_OUTER = parse(Int, opt("steady_outer", 2000))
+mkpath(OUTDIR)
+
+# ------------------------------------------------------------------------------------
+# Device memory: the stream-ordered pool (`AMDGPU.used_memory`, its high-water mark) and
+# the whole card (sysfs `mem_info_vram_used`, sampled every 20 ms: includes the
+# runtime, code objects, the pool's reserve and the desktop).
+# ------------------------------------------------------------------------------------
+const ROCM = GPU_PACKAGE == "AMDGPU"
+const SYSFS = get(ENV, "VRAM_SYSFS", "/sys/class/drm/card1/device/mem_info_vram_used")
+vram() = isfile(SYSFS) ? parse(Int, readchomp(SYSFS)) : 0
+sync() = ROCM ? AMDGPU.synchronize() : nothing
+pool_used() = ROCM ? (AMDGPU.synchronize(); Int(AMDGPU.used_memory())) : 0
+_pool() = AMDGPU.Mem.pool_create(AMDGPU.device())
+pool_peak() = ROCM ? (AMDGPU.synchronize(); Int(AMDGPU.HIP.attribute(UInt64, _pool(), AMDGPU.HIP.hipMemPoolAttrUsedMemHigh))) : 0
+pool_reset_peak!() = ROCM ? (AMDGPU.synchronize(); AMDGPU.HIP.attribute!(_pool(), AMDGPU.HIP.hipMemPoolAttrUsedMemHigh, UInt64(0)); nothing) : nothing
+mib(b) = round(b / 2^20; digits = 1)
+
+const VRAM_MAX = Threads.Atomic{Int}(0)
+const SAMPLING = Threads.Atomic{Bool}(true)
+sampler = Threads.@spawn while SAMPLING[]
+    Threads.atomic_max!(VRAM_MAX, vram())
+    sleep(0.02)
+end
+"Highest sysfs reading since the last call (and the current one)."
+vram_max!() = (v = max(VRAM_MAX[], vram()); VRAM_MAX[] = vram(); v)
+
+const LOG = Dict{String, Any}()
+const VRAM0 = vram()
+LOG["vram_before_mib"] = mib(VRAM0)
+"Record the memory state `name`: pool in use, pool peak and sysfs peak since the last record (net of the start)."
+function mark!(name)
+    sync()
+    d = Dict("pool_used_mib" => mib(pool_used()), "pool_peak_mib" => mib(pool_peak()),
+             "vram_peak_net_mib" => mib(vram_max!() - VRAM0), "vram_now_net_mib" => mib(vram() - VRAM0))
+    LOG["mem_$name"] = d
+    println("[mem] ", rpad(name, 22), join(("$k = $v" for (k, v) in sort(collect(d))), ", "))
+    flush(stdout)
+    return d
+end
+pool_reset_peak!()
+mark!("start")
+
+# ------------------------------------------------------------------------------------
+# The synthetic global5m model as ModflowCoupling static inputs
+# ------------------------------------------------------------------------------------
+
+"Permeability (log10 m²) for a conductivity in m/day (inverse of `permeability_to_conductivity`)."
+log10_permeability(k) = log10(k / (MC.RHO_WATER * MC.G_GRAVITY / MC.MU_WATER * 86400.0))
+
+"""
+ModflowCoupling `StaticInputs` from the synthetic fields `f` on the global 5′ grid:
+idomain = kind (land 1, ocean rim 2 = CHD at sea level), DEM, aquifer depth, K of both
+layers as permeabilities, storage coefficient as specific yield, bankfull discharge
+4 m³/s per upstream cell (river cells, ≥ 10 upstream cells, are wider than 30 m: RIV;
+the others drain-like), slope 1e-3, Z0 (drain level) `ddrn` below the DEM, KQ3 0.02 /day,
+one catchment per cell, EVT at the DEM with 1 mm/day and 2 m extinction depth, cell area
+DELR × DELC (uniform, as the synthetic model). Starting heads as the synthetic model
+(0.5 m above the drain level, 0 on the rim).
+"""
+function synthetic_inputs(f)
+    nx, ny = f.ncol, f.nrow
+    lon = [-180 + (i - 0.5) / 12 for i in 1:nx]
+    lat = [-90 + (j - 0.5) / 12 for j in 1:ny]
+    delr = delc = 1 / 12 * 111_000.0
+    land = f.kind .== 0x01
+    nan_off(a) = ifelse.(land, a, NaN)
+    top = f.top
+    aq = top .- f.botm[:, :, 2]
+    z0 = top .- f.ddrn
+    head = zeros(nx, ny, 2)
+    for l in 1:2
+        view(head, :, :, l) .= ifelse.(land, z0 .+ 0.5, ifelse.(f.kind .== 0x02, 0.0, NaN))
+    end
+    return MC.StaticInputs(;
+        lon, lat, delr, delc, idomain = Int.(f.kind), landmask = land,
+        dem = nan_off(top), aqdepth = nan_off(aq), cell_area = fill(delr * delc, nx, ny),
+        ksat_log = nan_off(log10_permeability.(f.k[:, :, 1])),
+        ksat_l1_conf_log = nan_off(log10_permeability.(f.k[:, :, 1])),
+        ksat_l2_conf_log = nan_off(log10_permeability.(f.k[:, :, 2])),
+        spe_yi = nan_off(f.sc), qbank = nan_off(min.(4.0 .* f.acc, 1.0e4)), riv_slope = nan_off(fill(1.0e-3, nx, ny)),
+        min_dem = nan_off(top), z0_floodplain = nan_off(z0), kq3 = nan_off(fill(0.02, nx, ny)),
+        catchment = nan_off(Float64.(reshape(1:(nx * ny), nx, ny))),
+        cpsurface = nan_off(top), cprate = nan_off(fill(1.0e-3, nx, ny)), cpdistinct = nan_off(fill(2.0, nx, ny)),
+        steady_head = head,
+    )
+end
+
+t_fields = @elapsed fields = synthetic_fields(:global5m)
+t_inputs = @elapsed inputs = synthetic_inputs(fields)
+LOG["host_fields_s"] = t_fields
+LOG["host_inputs_s"] = t_inputs
+println("synthetic global5m fields $(round(t_fields; digits = 1)) s, inputs $(round(t_inputs; digits = 1)) s")
+
+workdir = joinpath(OUTDIR, "work")
+solver(; kw...) = MC.SolverSettings(; engine = "gpu", backend = ROCM ? "rocm" : "auto", precision = PRECISION,
+                                    outer_dvclose = DVCLOSE, inner_dvclose = DVCLOSE, preconditioner = PRECOND, kw...)
+base = Config(; data_dir = workdir, work_dir = workdir, output_dir = workdir, start_date = Date(1979, 1, 1),
+              end_date = Date(1979, 1, 1) + Day(NDAYS - 1), inputs = Dict{String, MC.InputSpec}(), period = "day",
+              model_name = "GLOBAL5M", foc = true, write_monthly_output = false, check_orientation = true,
+              solver = solver())
+
+# ------------------------------------------------------------------------------------
+# mGV (real global inputs)
+# ------------------------------------------------------------------------------------
+vic = nothing
+if !isempty(MGV_CONFIG)
+    LOG["mgv_init_s"] = @elapsed global vic = BMI.initialize(mGV.Model, MGV_CONFIG)
+    LOG["mgv_cells"] = length(BMI.get_grid_x(vic, 0))
+    mark!("mgv_initialized")
+end
+
+# ------------------------------------------------------------------------------------
+# Steady-state spin-up
+# ------------------------------------------------------------------------------------
+"Iterations (outer, inner) of the last step of the GPU engine."
+iterations(gw) = (r = last(gw.mf.results).outer; (r.iterations, r.inner))
+
+ss_cfg = Config(base; period = "steady", end_date = base.start_date,
+                solver = solver(; outer_dvclose = STEADY_DVCLOSE, inner_dvclose = STEADY_DVCLOSE, preconditioner = STEADY_PRECOND,
+                                outer_maximum = STEADY_OUTER, under_relaxation_gamma = STEADY_GAMMA))
+LOG["steady_build_s"] = @elapsed ss = GroundwaterModel(ss_cfg, inputs)
+LOG["T"] = string(ss.mf.T); LOG["Ts"] = string(ss.mf.Ts); LOG["Tp"] = string(ss.mf.Tp)
+LOG["nodes"] = Int(ss.mf.model.conn.nodes)
+LOG["records"] = Dict("CHD" => 2 * length(ss.params.chd_cells), "RCH" => length(ss.params.rch_cells),
+                      "RIV" => length(ss.params.river.cells), "DRN" => length(ss.params.drain.cells),
+                      "EVT" => length(ss.params.evt_cells))
+mark!("steady_built")
+land = inputs.landmask
+BMI.set_value(ss, "groundwater_recharge", vec(ifelse.(land, fields.rch, 0.0)))
+BMI.set_value(ss, "river_discharge", vec(ifelse.(land, 0.3 .* inputs.qbank, 0.0)))
+t_ss = @elapsed begin
+    BMI.update(ss)
+    sync()
+end
+ss_it = iterations(ss)
+LOG["steady_s"] = t_ss
+LOG["steady_outer"], LOG["steady_inner"] = ss_it
+println("spin-up: $(round(t_ss; digits = 2)) s, $(ss_it[1]) outer / $(ss_it[2]) inner iterations ($(ss.mf.T), Tp = $(ss.mf.Tp))")
+mark!("steady_solved")
+steady_head = copy(MC.host_field(ss, :head))
+write(joinpath(OUTDIR, "head_steady.bin"), vec(steady_head[:, :, 1]))
+BMI.finalize(ss)
+ss = nothing
+GC.gc(true)
+mark!("steady_finalized")
+
+# ------------------------------------------------------------------------------------
+# Daily run from the spin-up heads
+# ------------------------------------------------------------------------------------
+day_inputs = MC.StaticInputs((getfield(inputs, f) for f in fieldnames(MC.StaticInputs)[1:(end - 1)])...,
+                             ifelse.(isfinite.(steady_head), steady_head, inputs.steady_head))
+LOG["daily_build_s"] = @elapsed gw = GroundwaterModel(base, day_inputs)
+mark!("daily_built")
+backend = KA.get_backend(gw.dev.h)
+coupling = vic === nothing ? nothing : Coupling(gw, vic; exchange = :device)
+coupling === nothing || mark!("coupling_built")
+# The synthetic recharge and 0.3 × bankfull discharge, with the seasonal factors of the
+# synthetic model, as device arrays (no host transfer per day). MODFLOW alone takes both;
+# coupled, it takes mGV's recharge and this discharge: mGV's real river discharge on the
+# synthetic channels (whose widths come from the synthetic bankfull discharge) sets stages
+# tens of metres above the river bed, and day 2 did not converge in 200 outer iterations
+# (first attempt, `:mixed`, closure 0.01). mGV's discharge is still gathered and converted
+# on the device every day (into `qmgv`), so the exchange costs what it would.
+rch0 = KA.allocate(backend, Float32, length(land)); copyto!(rch0, Float32.(vec(ifelse.(land, fields.rch, 0.0))))
+q0 = KA.allocate(backend, Float32, length(land)); copyto!(q0, Float32.(vec(ifelse.(land, 0.3 .* inputs.qbank, 0.0))))
+rch, q = similar(rch0), similar(q0)
+qmgv = KA.allocate(backend, gw.mf.T, length(land))
+
+rows = NamedTuple[]
+for day in 1:NDAYS
+    t0 = time_ns()
+    if coupling !== nothing
+        c = coupling
+        n = c.n_vic
+        w = BMI.get_value_ptr(vic, "soil__moisture")
+        wmax = BMI.get_value_ptr(vic, "soil__moisture~maximum")
+        add_capillary_rise_kernel!(backend)(w, wmax, c.cpr, n, length(w) ÷ n; ndrange = n)
+        area = BMI.get_value_ptr(vic, "channel_water__area~cross-sectional")
+        add_baseflow_kernel!(backend)(area, c.requested_cell, c.applied_cell, c.baseflow, c.cell_length, c.dt; ndrange = n)
+        BMI.update(vic)
+        sync()
+        t1 = time_ns()
+        q .= q0 .* Float32(1 + 0.5 * cos(2π * mod(day - 1, 12) / 12))
+        MC.gather_convert!(qmgv, BMI.get_value_ptr(vic, "channel_water__volume_flow_rate"), c.dev_vic_to_mf, 1)
+        set_value_device!(gw, "river_discharge", q)
+        set_value_device!(gw, "groundwater_recharge", BMI.get_value_ptr(vic, "land_subsurface__runoff"); map = c.dev_vic_to_mf, divisor = 1000)
+        BMI.update(gw)
+        get_value_device!(c.baseflow, gw, "baseflow_to_routing"; map = c.dev_mf_to_vic)
+        get_value_device!(c.cpr, gw, "capillary_rise"; map = c.dev_mf_to_vic)
+        sync()
+    else
+        k = mod(day - 1, 12)
+        rch .= rch0 .* Float32(1 + 0.8 * sin(2π * k / 12))
+        q .= q0 .* Float32(1 + 0.5 * cos(2π * k / 12))
+        t1 = time_ns()
+        set_value_device!(gw, "river_discharge", q)
+        set_value_device!(gw, "groundwater_recharge", rch)
+        BMI.update(gw)
+        sync()
+    end
+    t2 = time_ns()
+    o, i = iterations(gw)
+    push!(rows, (; day, total = (t2 - t0) / 1e9, mgv = (t1 - t0) / 1e9, modflow = (t2 - t1) / 1e9, outer = o, inner = i))
+    (day <= 3 || day % 30 == 0) && (println("day $day: ", rows[end]); flush(stdout))
+end
+mark!("daily_done")
+
+open(joinpath(OUTDIR, "days.csv"), "w") do io
+    println(io, "day,total_s,mgv_s,modflow_s,outer,inner")
+    for r in rows
+        println(io, join((r.day, r.total, r.mgv, r.modflow, r.outer, r.inner), ","))
+    end
+end
+write(joinpath(OUTDIR, "head_final.bin"), vec(MC.host_field(gw, :head)[:, :, 1]))
+later = rows[min(3, end):end]   # from day 3: day 1 compiles, day 2 may still
+for (k, key) in (("total", :total), ("mgv", :mgv), ("modflow", :modflow))
+    LOG["median_$(k)_ms"] = 1000 * median(getfield.(later, key))
+end
+LOG["days"] = NDAYS
+LOG["days_total_from_day2_s"] = sum(getfield.(rows[min(2, end):end], :total))
+LOG["outer_total"] = sum(getfield.(rows, :outer))
+LOG["inner_total"] = sum(getfield.(rows, :inner))
+if coupling !== nothing
+    LOG["baseflow_requested_m3"], LOG["baseflow_applied_m3"] = baseflow_volumes(coupling)
+end
+println("median per day from day 3: total $(round(LOG["median_total_ms"]; digits = 1)) ms, mGV $(round(LOG["median_mgv_ms"]; digits = 1)) ms, MODFLOW $(round(LOG["median_modflow_ms"]; digits = 1)) ms")
+
+BMI.finalize(gw)
+foreach(KA.unsafe_free!, (rch0, q0, rch, q, qmgv))
+coupling === nothing || ModflowGPU.free_device_arrays!(coupling)
+coupling = nothing; gw = nothing
+GC.gc(true)
+mark!("modflow_finalized")
+if vic !== nothing
+    BMI.finalize(vic)
+    GC.gc(true)
+    mark!("mgv_finalized")
+    vic = nothing
+    GC.gc(true); GC.gc(true)
+    mark!("mgv_dropped")
+end
+SAMPLING[] = false
+wait(sampler)
+LOG["vram_peak_net_mib_overall"] = maximum(v["vram_peak_net_mib"] for (k, v) in LOG if startswith(k, "mem_"))
+LOG["pool_peak_mib_overall"] = maximum(v["pool_peak_mib"] for (k, v) in LOG if startswith(k, "mem_"))
+LOG["options"] = Dict(OPTS)
+open(io -> TOML.print(io, LOG; sorted = true), joinpath(OUTDIR, "summary.toml"), "w")
+println("written $(OUTDIR)/summary.toml")
