index 0000000..a4d618d
--- /dev/null
+++ b/src/cell_maps.jl
@@ -0,0 +1,79 @@
+#=
+Cell maps between the MODFLOW grid and another model's cells (mGV), by cell centre, for
+the exchange of `set_value_device!` / `get_value_device!` (examples/mgv_coupling). Built
+once on the host; at global size (2.3 M mGV cells on a 4320 × 1680 grid) a per-cell
+search over all coordinates (`argmin(abs.(v .- x))`, about 1e10 operations) is replaced
+by a binary search in the sorted coordinates.
+=#
+
+"""
+    coordinate_index(coords, x; atol, rev = !issorted(coords)) -> Int
+
+Index of the coordinate of `coords` (sorted ascending, or descending with `rev = true`)
+nearest to `x`, or 0 when it is more than `atol` away. Ties go to the lower index (as
+`argmin`). A binary search: O(log n).
+"""
+function coordinate_index(coords::AbstractVector, x::Real; atol::Real, rev::Bool = !issorted(coords))
+    i = searchsortedfirst(coords, x; rev)
+    best, dist = 0, Inf
+    for j in (i - 1, i)
+        1 <= j <= length(coords) || continue
+        d = abs(coords[j] - x)
+        if d < dist
+            best, dist = j, d
+        end
+    end
+    return dist <= atol ? best : 0
+end
+
+"""
+    cell_maps(mf_x, mf_y, vic_x, vic_y; atol = 1e-3) -> (mf_to_vic, vic_to_mf)
+
+Cell maps between the MODFLOW grid (rectilinear, `mf_x` × `mf_y` cell centres, each
+sorted ascending or descending, flattened longitude-fastest) and the cells of another
+model given by their centres `(vic_x[k], vic_y[k])` (mGV `main`: an unstructured grid of
+the active land cells). Returns for every mGV cell the MODFLOW cell with the same centre
+(within `atol` degrees in each coordinate), and for every MODFLOW cell the mGV cell; 0
+where the other grid has no such cell. Two mGV cells on one MODFLOW cell are an error.
+Both maps are checked with `check_cell_map`.
+"""
+function cell_maps(mf_x::AbstractVector, mf_y::AbstractVector, vic_x::AbstractVector, vic_y::AbstractVector;
+                   atol::Real = 1e-3)
+    length(vic_x) == length(vic_y) || error("cell_maps: $(length(vic_x)) x and $(length(vic_y)) y coordinates")
+    monotone(v) = issorted(v) || issorted(v; rev = true) ||
+        error("cell_maps: the MODFLOW coordinates must be sorted (ascending or descending)")
+    monotone(mf_x)
+    monotone(mf_y)
+    nx = length(mf_x)
+    revx, revy = !issorted(mf_x), !issorted(mf_y)
+    mf_to_vic = Vector{Int}(undef, length(vic_x))
+    for k in eachindex(vic_x, vic_y)
+        i = coordinate_index(mf_x, vic_x[k]; atol, rev = revx)
+        j = coordinate_index(mf_y, vic_y[k]; atol, rev = revy)
+        mf_to_vic[k] = (i > 0 && j > 0) ? i + (j - 1) * nx : 0
+    end
+    vic_to_mf = zeros(Int, nx * length(mf_y))
+    for (k, i) in enumerate(mf_to_vic)
+        i == 0 && continue
+        vic_to_mf[i] == 0 || error("mGV cells $(vic_to_mf[i]) and $k have the same MODFLOW cell $i")
+        vic_to_mf[i] = k
+    end
+    check_cell_map(mf_to_vic, length(vic_to_mf); name = "mf_to_vic")
+    check_cell_map(vic_to_mf, length(mf_to_vic); name = "vic_to_mf")
+    return mf_to_vic, vic_to_mf
+end
+
+"""
+    check_cell_map(map, nsource; name = "cell map") -> map
+
+Check on the host that every entry of a gather map is 0 (no source cell) or a valid index
+of a source of length `nsource`, and that it fits in `Int32` (the device maps of
+`set_value_device!` / `get_value_device!`, whose kernel reads `src[map[i]]` without bounds
+checks). Call it where the map is built, before it goes to the device.
+"""
+function check_cell_map(map::AbstractVector{<:Integer}, nsource::Integer; name::AbstractString = "cell map")
+    nsource <= typemax(Int32) || error("$name: a source of $nsource values does not fit Int32 indices")
+    bad = findfirst(k -> !(0 <= k <= nsource), map)
+    bad === nothing || error("$name: entry $bad is $(map[bad]), outside 0:$nsource (the source length)")
+    return map
+end
