index 0000000..a55d304
--- /dev/null
+++ b/examples/global/merge_routing_tiles.py
@@ -0,0 +1,122 @@
+# /// script
+# requires-python = ">=3.12"
+# dependencies = ["netCDF4", "numpy", "xarray"]
+# ///
+"""Merge routing files of make-routing.py (mGV-input-data) for adjacent longitude boxes.
+
+ModflowGPU T5.5a: make-routing.py with the global box (--bbox -180 -56 180 84) needs more
+than 50 GB of memory (killed in the IHU upscaling step on a 61 GB machine), so the global
+file is made from boxes that split the globe at a meridian, here -25 (in the Atlantic: it
+crosses only Greenland's ice sheet; Iceland lies east of it). Each box is a complete
+network; cells that drain across the seam become outlets, as at the edge of any box.
+
+The boxes must be on one grid (same resolution, latitudes and longitude spacing) and
+adjacent in longitude, given west to east. The merged file has the variables, attributes
+and conventions of make-routing.py: ids 1..N in (lat, lon) order with latitude from
+south to north, `downstream` the id of the downstream cell (outlets drain to themselves).
+
+`--fill-domain <mGV parameter file>`: mGV needs routing values on every active cell of
+its parameter file (`run_cell > 0`). Active cells without HydroSHEDS land data (2,841 on
+the global 5' grid) are added as one-cell basins: their own outlet, with the spherical
+cell area (as make-routing.py), `cell_dist` sqrt(cell_area) (what make-routing.py writes
+for outlets) and the cell area as accumulation; `flow_direction` 0 (outlet).
+
+Usage:
+    uv run merge_routing_tiles.py --output routing_global.nc [--fill-domain params.nc] west.nc east.nc
+"""
+
+import argparse
+from datetime import datetime, timezone
+
+import numpy as np
+import xarray as xr
+
+EARTH_RADIUS = 6371.0e3  # m, as make-routing.py
+
+
+def cell_area(lat, res):
+    """Spherical area [m2] of cells with centre latitude lat and size res (degrees), as make-routing.py."""
+    return EARTH_RADIUS**2 * np.deg2rad(res) * np.abs(np.sin(np.deg2rad(lat + res / 2)) - np.sin(np.deg2rad(lat - res / 2)))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("tiles", nargs="+", help="routing files, west to east")
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--fill-domain", help="mGV parameter file: add its active cells without routing data as outlets")
+    args = parser.parse_args()
+
+    tiles = [xr.open_dataset(p, mask_and_scale=False) for p in args.tiles]
+    lat = tiles[0]["lat"].values
+    for p, t in zip(args.tiles, tiles):
+        if not np.array_equal(t["lat"].values, lat):
+            raise ValueError(f"{p}: latitudes differ from {args.tiles[0]}")
+    lon = np.concatenate([t["lon"].values for t in tiles])
+    steps = np.diff(lon)
+    if not np.allclose(steps, steps[0], rtol=0, atol=1e-6 * abs(steps[0])):
+        raise ValueError("the tiles are not adjacent on one longitude grid (give them west to east)")
+    res = abs(steps[0])
+
+    ids = [t["downstream_id"].values.astype(np.int64) for t in tiles]
+    routed = np.concatenate([i > 0 for i in ids], axis=1)
+    filled = np.zeros_like(routed)
+    if args.fill_domain:
+        with xr.open_dataset(args.fill_domain) as p:
+            if not (np.allclose(p["lat"].values, lat, atol=1e-4) and np.allclose(p["lon"].values, lon, atol=1e-4)):
+                raise ValueError(f"{args.fill_domain} is on another grid")
+            run_cell = np.nan_to_num(p["run_cell"].values.astype(np.float64)) > 0
+        filled = run_cell & ~routed
+    valid = routed | filled
+
+    # New ids: 1..N over the merged grid in (lat, lon) order, latitude south to north (the
+    # files store latitude ascending, as make-routing.py writes them)
+    new_id = np.zeros(valid.shape, dtype=np.int64)
+    new_id[valid] = np.arange(1, valid.sum() + 1)
+    downstream = np.full(valid.shape, -1, dtype=np.int64)
+    col = 0
+    for t, old in zip(tiles, ids):
+        n = old.shape[1]
+        block = new_id[:, col : col + n]
+        lookup = np.zeros(old.max() + 1, dtype=np.int64)  # old id -> new id within this tile
+        lookup[old[old > 0]] = block[old > 0]
+        ds = t["downstream"].values.astype(np.int64)
+        sel = old > 0
+        sub = downstream[:, col : col + n]
+        sub[sel] = lookup[ds[sel]]
+        col += n
+    downstream[filled] = new_id[filled]
+    if np.any(downstream[valid] <= 0):
+        raise ValueError("a downstream id was not found in its tile")
+
+    area = cell_area(np.broadcast_to(lat[:, None], valid.shape), res)
+    fill_values = {"cell_area": area, "accumulation": area, "cell_dist": np.sqrt(area), "flow_direction": np.zeros(valid.shape)}
+    out = xr.Dataset(coords={"lat": tiles[0]["lat"], "lon": ("lon", lon, tiles[0]["lon"].attrs)})
+    for name in tiles[0].data_vars:
+        attrs = tiles[0][name].attrs
+        if name == "downstream_id":
+            data = np.where(valid, new_id, -1).astype(np.int32)
+        elif name == "downstream":
+            data = np.where(valid, downstream, -1).astype(np.int32)
+        else:
+            data = np.concatenate([t[name].values for t in tiles], axis=1)
+            if name in fill_values:
+                data[filled] = fill_values[name][filled].astype(data.dtype)
+        out[name] = (("lat", "lon"), data, {k: v for k, v in attrs.items() if k != "_FillValue"})
+    out.attrs = dict(tiles[0].attrs)
+    out.attrs["history"] = (
+        f"{datetime.now(timezone.utc):%Y-%m-%d %H:%M:%S} UTC: merge_routing_tiles.py of "
+        + ", ".join(f"[{t.attrs.get('history', '?')}]" for t in tiles)
+        + (f"; {int(filled.sum())} active cells of {args.fill_domain} without routing data added as outlets" if filled.any() else "")
+    )
+    encoding = {v: {"zlib": True, "complevel": 4} for v in out.data_vars}
+    for v in out.data_vars:
+        fill = tiles[0][v].attrs.get("_FillValue", tiles[0][v].encoding.get("_FillValue"))
+        if fill is not None:
+            encoding[v]["_FillValue"] = fill
+    out.to_netcdf(args.output, encoding=encoding)
+    print(f"written {args.output}: {lat.size} x {lon.size}, {valid.sum()} network cells, "
+          f"{int((new_id[valid] == downstream[valid]).sum())} outlets, {int(filled.sum())} cells added from the domain")
+
+
+if __name__ == "__main__":
+    main()
