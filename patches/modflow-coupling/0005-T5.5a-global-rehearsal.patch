+        active = cat(s.idomain .> 0, s.idomain .> 0; dims = 3)
+        # Not the 1e-3 m :single tolerance: the Float32 steady state of the Indus stops about
+        # 0.03 m from the converged heads at any closure and with either preconditioner
+        # (ModflowGPU T5.5a; 0.045 m here, both at closure 0.01), so spin-ups run in :mixed.
+        @test maximum(abs.(heads["single"] .- heads["double"])[active]) < 0.1
+    end
 end
 
