+"""
+    StaticInputs(; lon, lat, idomain, landmask, dem, aqdepth, cell_area, ksat_log, spe_yi,
+                 qbank, riv_slope, min_dem, z0_floodplain, kq3, catchment, ...)
+
+Static inputs from arrays (`(lon, lat)` maps on the model grid, latitude ascending; see the
+grid convention above), for `GroundwaterModel(config, inputs)`. The optional inputs of
+`INPUT_ROLES` (`ksat_l1_conf_log`, `ksat_l2_conf_log`, `cpsurface`, `cprate`,
+`cpdistinct`, `steady_head`) default to NaN; `delr` and `delc` default to the coordinate
+spacing × 111 km, as `read_grid`.
+"""
+function StaticInputs(; lon, lat, idomain, landmask, dem, aqdepth, cell_area, ksat_log, spe_yi, qbank,
+                      riv_slope, min_dem, z0_floodplain, kq3, catchment,
+                      delr = (lon[end] - lon[1]) / (length(lon) - 1) * 111_000.0,
+                      delc = (lat[end] - lat[1]) / (length(lat) - 1) * 111_000.0,
+                      ksat_l1_conf_log = nothing, ksat_l2_conf_log = nothing, cpsurface = nothing,
+                      cprate = nothing, cpdistinct = nothing, steady_head = nothing)
+    grid = (length(lon), length(lat))
+    issorted(lon) && issorted(lat) || error("StaticInputs: lon and lat must be ascending")
+    field(a, name) = (a === nothing ? fill(NaN, grid) :
+                      size(a) == grid ? Matrix{Float64}(a) : error("StaticInputs: $name has size $(size(a)), the grid is $grid"))
+    head = steady_head === nothing ? fill(NaN, grid..., 2) : Array{Float64,3}(steady_head)
+    size(head) == (grid..., 2) || error("StaticInputs: steady_head has size $(size(head)), expected $((grid..., 2))")
+    size(idomain) == grid || error("StaticInputs: idomain has size $(size(idomain)), the grid is $grid")
+    size(landmask) == grid || error("StaticInputs: landmask has size $(size(landmask)), the grid is $grid")
+    return StaticInputs(
+        Float64.(lon), Float64.(lat), Float64(delr), Float64(delc), Int.(idomain), BitMatrix(landmask),
+        field(dem, "dem"), field(aqdepth, "aqdepth"), field(cell_area, "cell_area"), field(ksat_log, "ksat_log"),
+        field(ksat_l1_conf_log, "ksat_l1_conf_log"), field(ksat_l2_conf_log, "ksat_l2_conf_log"),
+        field(spe_yi, "spe_yi"), field(qbank, "qbank"), field(riv_slope, "riv_slope"), field(min_dem, "min_dem"),
+        field(z0_floodplain, "z0_floodplain"), field(cpsurface, "cpsurface"), field(cprate, "cprate"),
+        field(cpdistinct, "cpdistinct"), field(kq3, "kq3"), field(catchment, "catchment"), head,
+    )
+end
