+julia --project=examples/mgv_coupling examples/global/compare_indus.jl spinup=<spinup>/heads_final.nc
+```
diff --git a/examples/global/compare_indus.jl b/examples/global/compare_indus.jl
new file mode 100644
index 0000000..047a52e
--- /dev/null
+++ b/examples/global/compare_indus.jl
@@ -0,0 +1,59 @@
+#= Sanity check of the global coupled heads (ModflowGPU T5.5b): their Indus cut against the
+Indus steady states in INDUS_DATA (`steady_head_mgv_coupled.nc`, the coupled mGV-MODFLOW
+Indus steady state; `mf_ss_gwl_5minDRN.nc`, the earlier global MODFLOW steady state, see
+NOTES.md there) and the provided start heads. Differences are reported, not tested: the
+domains and boundaries differ.
+
+    julia --project=examples/mgv_coupling examples/global/compare_indus.jl <heads.nc> [label=heads.nc ...]
+=#
+using NCDatasets, Statistics, Printf
+
+const DATA = get(ENV, "INDUS_DATA", "/home/bart/data/modflow/data")
+const START = "/home/bart/data/mGV/global_60N/modflow/initial_head_gv2p41_5min_nogl_chd0_60N.nc"
+
+# (lon, lat, layer) Float64 heads and their coordinates
+function read_global(path)
+    NCDataset(path) do ds
+        v = haskey(ds, "gwl") ? "gwl" : "gwd"
+        lon = Float64.(ds[haskey(ds, "lon") ? "lon" : "longitude"][:])
+        lat = Float64.(ds[haskey(ds, "lat") ? "lat" : "latitude"][:])
+        h = Float64.(coalesce.(ds[v][:, :, :], NaN))
+        lon, lat, h
+    end
+end
+cut(g, lon, lat) = let (glon, glat, h) = g
+    i = [argmin(abs.(glon .- x)) for x in lon]
+    j = [argmin(abs.(glat .- y)) for y in lat]
+    # within half a 5′ cell: mf_ss_gwl_5minDRN.nc labels its 4320 columns -180 … 180 (not the
+    # cell centres), which puts its labels up to 0.02° off the centres in the Indus
+    maximum(abs.(glon[i] .- lon)) < 1 / 24 && maximum(abs.(glat[j] .- lat)) < 1 / 24 || error("grids do not line up")
+    h[i, j, :]
+end
+
+ref_lon, ref_lat, ref = read_global(joinpath(DATA, "steady_head_mgv_coupled.nc"))
+dem = NCDataset(joinpath(DATA, "..", "global_data", "dem_ini_oc.nc")) do ds
+    cut((Float64.(ds["lon"][:]), Float64.(ds["lat"][:]), reshape(Float64.(coalesce.(ds["elev"][:, :], NaN)), 4320, 1680, 1)), ref_lon, ref_lat)[:, :, 1]
+end
+fields = Dict("indus_coupled" => ref, "mf_ss_gwl_5minDRN" => cut(read_global(joinpath(DATA, "mf_ss_gwl_5minDRN.nc")), ref_lon, ref_lat),
+              "start (provided)" => cut(read_global(START), ref_lon, ref_lat))
+for a in ARGS
+    label, path = occursin("=", a) ? split(a, "="; limit = 2) : (basename(a), a)
+    fields[String(label)] = cut(read_global(path), ref_lon, ref_lat)
+end
+labels = sort(collect(keys(fields)))
+@printf("Indus cut: %d x %d cells, %d with a coupled Indus steady head (layer 1)\n", length(ref_lon), length(ref_lat), count(isfinite, ref[:, :, 1]))
+for l in 1:2, (ia, a) in enumerate(labels), b in labels[(ia + 1):end]
+    x, y = fields[a][:, :, l], fields[b][:, :, l]
+    m = isfinite.(x) .& isfinite.(y)
+    count(m) == 0 && continue
+    d = (x .- y)[m]
+    @printf("layer %d, %-22s - %-22s: n %6d, mean %+8.2f m, median %+8.2f, mean |d| %7.2f, p05 %+8.2f, p95 %+8.2f, corr %.4f\n",
+            l, a, b, count(m), mean(d), median(d), mean(abs.(d)), quantile(d, 0.05), quantile(d, 0.95), cor(x[m], y[m]))
+end
+for a in labels
+    h = fields[a][:, :, 1]
+    m = isfinite.(h) .& isfinite.(dem) .& isfinite.(ref[:, :, 1])
+    depth = (dem .- h)[m]
+    @printf("%-22s: depth below the DEM (layer 1, Indus cells): median %7.1f m, p10 %7.1f, p90 %7.1f, above the DEM %.1f %%\n",
+            a, median(depth), quantile(depth, 0.1), quantile(depth, 0.9), 100 * count(<(0), depth) / length(depth))
+end
