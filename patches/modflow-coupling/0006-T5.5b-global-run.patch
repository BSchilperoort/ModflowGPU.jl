index 0000000..deb51c6
--- /dev/null
+++ b/examples/global/run_global.jl
@@ -0,0 +1,443 @@
+#= The global coupled run of ModflowGPU T5.5b: mGV and MODFLOW (GPU engine) on one GPU, north
+of 60°N masked out (`global_60N.toml`, `mgv_global_60N.toml`, derived inputs of
+`make_60N_inputs.jl`).
+
+    MGV_BACKEND=rocm julia -t 8 --project=examples/mgv_coupling examples/global/run_global.jl <outdir> key=value ...
+
+Modes (`mode=`):
+
+- `spinup` (default): the coupled spin-up. mGV's forcing is the land-only WFDE5 store of
+  1979, cycled: after each year mGV's clock is set back to 1979-01-01 (its state kept), so
+  every simulated year sees the same forcing and the year-to-year change is the drift.
+  MODFLOW runs daily periods in segments of `segment` years (one `GroundwaterModel` per
+  segment, built from the heads at the end of the previous one; heads are MODFLOW's whole
+  state). At the end of every segment a checkpoint is written (`<outdir>/checkpoint_yNNNN/`:
+  heads as NetCDF, mGV's state, the coupling's feedback), from which `resume=<dir>`
+  continues. Stops when the stopping criterion (all four `crit_*` below, year against the
+  previous year) holds for `window` consecutive years, or after `years` years.
+- `daily`: `days` coupled days from a checkpoint (`resume=`, required), timed per day
+  (mGV and MODFLOW separately), at closure `closure` (outer = inner dvclose).
+
+Keys: years=200, segment=10, resume=, closure=0.01, days=365, precision=mixed,
+limit=1 (river-loss limit), crit_dh=0.01 (m/yr, mean |Δh| of layer 1),
+crit_p99=0.1 (m/yr, 99th percentile |Δh| of layer 1), crit_bf=0.001 (relative change of the
+annual baseflow), crit_sto=0.01 (|MODFLOW storage change over the year| / annual recharge), window=5, keep=2 (checkpoints kept), qmax=1e6 (m³/s: a larger mGV
+discharge stops the run as implausible).
+
+Outputs: `days.csv` (per day: mGV discharge max and non-finite cells, MODFLOW iterations,
+budget terms, channel storage, created water, times), `years.csv` (per year: head change
+per layer, baseflow, net exchange, storage change, channel storage, created water,
+iterations, wall time), `summary.toml` (memory, times), `heads_final.nc`.
+=#
+using AMDGPU
+include(joinpath(@__DIR__, "..", "mgv_coupling", "coupling.jl"))
+using Statistics, Serialization, NCDatasets, TOML
+
+const OUTDIR = abspath(ARGS[1])
+mkpath(OUTDIR)
+const OPTS = Dict(String(split(a, "="; limit = 2)[1]) => String(split(a, "="; limit = 2)[2]) for a in ARGS[2:end])
+opt(k, d) = get(OPTS, k, string(d))
+const MODE = opt("mode", "spinup")
+const YEARS = parse(Int, opt("years", 200))
+const SEGMENT = parse(Int, opt("segment", 10))
+const RESUME = opt("resume", "")
+const CLOSURE = parse(Float64, opt("closure", 0.01))
+const DAYS = parse(Int, opt("days", 365))
+const PRECISION = opt("precision", "mixed")
+const LIMIT = opt("limit", 1) == "1"
+const CRIT_DH = parse(Float64, opt("crit_dh", 0.01))
+const CRIT_P99 = parse(Float64, opt("crit_p99", 0.1))
+const CRIT_BF = parse(Float64, opt("crit_bf", 0.001))
+const CRIT_STO = parse(Float64, opt("crit_sto", 0.01))
+const WINDOW = parse(Int, opt("window", 5))
+const KEEP = parse(Int, opt("keep", 2))
+const QMAX = parse(Float64, opt("qmax", 1e6))
+const MF_CONFIG = joinpath(@__DIR__, "global_60N.toml")
+const MGV_CONFIG = joinpath(@__DIR__, "mgv_global_60N.toml")
+MODE in ("spinup", "daily") || error("mode must be spinup or daily")
+MODE == "daily" && isempty(RESUME) && error("mode=daily needs resume=<checkpoint dir>")
+println("run_global: ", join(("$k=$v" for (k, v) in sort(collect(OPTS))), " "), " (mode $MODE)")
+flush(stdout)
+
+# ------------------------------------------------------------------------------------
+# Device memory (as global_rehearsal.jl): the stream-ordered pool and the card (sysfs)
+# ------------------------------------------------------------------------------------
+const SYSFS = get(ENV, "VRAM_SYSFS", "/sys/class/drm/card1/device/mem_info_vram_used")
+vram() = isfile(SYSFS) ? parse(Int, readchomp(SYSFS)) : 0
+sync() = AMDGPU.synchronize()
+_pool() = AMDGPU.Mem.pool_create(AMDGPU.device())
+pool_used() = (sync(); Int(AMDGPU.used_memory()))
+pool_peak() = (sync(); Int(AMDGPU.HIP.attribute(UInt64, _pool(), AMDGPU.HIP.hipMemPoolAttrUsedMemHigh)))
+mib(b) = round(b / 2^20; digits = 1)
+const VRAM_MAX = Threads.Atomic{Int}(0)
+const SAMPLING = Threads.Atomic{Bool}(true)
+sampler = Threads.@spawn while SAMPLING[]
+    Threads.atomic_max!(VRAM_MAX, vram())
+    sleep(0.05)
+end
+const VRAM0 = vram()
+const SUMMARY = Dict{String, Any}("mode" => MODE, "options" => OPTS, "vram_before_mib" => mib(VRAM0))
+function mark!(name)
+    d = Dict("pool_used_mib" => mib(pool_used()), "pool_peak_mib" => mib(pool_peak()),
+             "vram_peak_net_mib" => mib(max(VRAM_MAX[], vram()) - VRAM0), "vram_now_net_mib" => mib(vram() - VRAM0))
+    SUMMARY["mem_$name"] = d
+    println("[mem] ", rpad(name, 20), join(("$k = $v" for (k, v) in sort(collect(d))), ", "))
+    flush(stdout)
+    return d
+end
+write_summary() = open(io -> TOML.print(io, SUMMARY), joinpath(OUTDIR, "summary.toml"), "w")
+
+# ------------------------------------------------------------------------------------
+# MODFLOW inputs and heads
+# ------------------------------------------------------------------------------------
+const BASE = load_config(MF_CONFIG)
+const STATIC = let t0 = time()
+    s = read_static_inputs(BASE)
+    # The derived ibound and land mask end at 60N; the other inputs are the global files.
+    # NaN north of 60N, so nothing there looks like land (orientation audit: bankfull
+    # discharge only on land) and no package gets a record on a removed cell.
+    north = repeat(reshape(s.lat .> 60.0, 1, :), length(s.lon), 1)
+    any(s.idomain[north] .> 0) && error("ibound is active north of 60N: use the derived 60N ibound")
+    for f in fieldnames(MC.StaticInputs)
+        x = getfield(s, f)
+        (x isa Matrix{Float64} && size(x) == size(north) && !(f in (:idomain, :landmask))) && (x[north] .= NaN)
+    end
+    println("MODFLOW static inputs read in $(round(time() - t0; digits = 1)) s"); flush(stdout)
+    s
+end
+const ACTIVE = STATIC.idomain .== 1   # land cells (CHD cells are fixed)
+# `StaticInputs` with the initial heads `h` (the steady_head input only sets the initial
+# and CHD heads; the CHD cells keep 0 m in every head written here)
+inputs_with(h) = MC.StaticInputs(; (f => getfield(STATIC, f) for f in fieldnames(MC.StaticInputs) if f != :steady_head)..., steady_head = h)
+
+"Heads `(lon, lat, layer)` as NetCDF (`gwl`, ModflowCoupling's `initial_head_file` layout)."
+function write_heads(path, h)
+    tmp = path * ".tmp"
+    NCDataset(tmp, "c") do ds
+        defDim(ds, "lon", length(STATIC.lon)); defDim(ds, "lat", length(STATIC.lat)); defDim(ds, "layer", 2)
+        defVar(ds, "lon", STATIC.lon, ("lon",); attrib = ["units" => "degrees_east"])
+        defVar(ds, "lat", STATIC.lat, ("lat",); attrib = ["units" => "degrees_north"])
+        defVar(ds, "gwl", Float64.(h), ("lon", "lat", "layer");
+               attrib = ["units" => "m", "_FillValue" => NaN, "long_name" => "groundwater head (layer 1 top, 2 bottom)"],
+               deflatelevel = 4, chunksizes = [720, 560, 1])
+        ds.attrib["source"] = "ModflowGPU T5.5b coupled global run (run_global.jl), north of 60N masked"
+    end
+    mv(tmp, path; force = true)
+    return path
+end
+read_heads(path) = NCDataset(ds -> Float64.(coalesce.(ds["gwl"][:, :, :], NaN)), path)
+
+function model_config(nyears_or_days; days = false)
+    n = days ? nyears_or_days : 365 * nyears_or_days
+    sv = MC.SolverSettings(; BASE.solver.engine, precision = PRECISION, outer_dvclose = CLOSURE, inner_dvclose = CLOSURE)
+    return Config(BASE; start_date = Date(1979, 1, 1), end_date = Date(1979, 1, 1) + Day(n - 1), period = "day",
+                  work_dir = joinpath(OUTDIR, "mf6"), output_dir = joinpath(OUTDIR, "output"),
+                  write_monthly_output = false, initial_head_file = "", solver = sv)
+end
+
+# ------------------------------------------------------------------------------------
+# mGV: state checkpoint and the forcing cycle (mGV `main` has neither; done from outside
+# through its state structs, without changing mGV)
+# ------------------------------------------------------------------------------------
+const MGV_STATE = (:surface_energy_variables, :canopy_variables, :soil_variables, :snow_variables)
+const ROUTING_STATE = (:area, :discharge, :travel_time, :cfl)
+
+"mGV's state as host arrays (every array of its state structs, the routing state, the clock)."
+function mgv_state(vic)
+    st = Dict{String, Any}()
+    for s in MGV_STATE, f in fieldnames(typeof(getfield(vic, s)))
+        x = getfield(getfield(vic, s), f)
+        x isa AbstractArray && (st["$s.$f"] = Array(x))
+    end
+    for f in ROUTING_STATE
+        st["routing.$f"] = Array(getfield(vic.routing, f))
+    end
+    st["clock.iteration"] = vic.clock.iteration
+    st["clock.time"] = vic.clock.time
+    return st
+end
+
+function restore_mgv_state!(vic, st)
+    for (k, v) in st
+        startswith(k, "clock.") && continue
+        s, f = Symbol.(split(k, "."))
+        dest = getfield(s === :routing ? vic.routing : getfield(vic, s), f)
+        size(dest) == size(v) || error("mGV state $k has size $(size(v)), the model $(size(dest))")
+        copyto!(dest, v)
+    end
+    vic.clock.iteration = st["clock.iteration"]
+    vic.clock.time = st["clock.time"]
+    mGV.update_forcing!(vic.clock.time, vic.forcing_readers, vic.forcing_variables)
+    mGV.load_monthly_parameters!(vic.vegetation_parameters, vic.monthly_vegetation_parameters, month(vic.clock.time))
+    return vic
+end
+
+"Start mGV's forcing year again (1979-01-01), keeping its state."
+function restart_forcing_year!(vic)
+    vic.clock.time = DateTime(vic.config.start_year)
+    mGV.update_forcing!(vic.clock.time, vic.forcing_readers, vic.forcing_variables)
+    mGV.load_monthly_parameters!(vic.vegetation_parameters, vic.monthly_vegetation_parameters, month(vic.clock.time))
+    return vic
+end
+
+# ------------------------------------------------------------------------------------
+# Checkpoints
+# ------------------------------------------------------------------------------------
+function write_checkpoint(year, h, vic, c, counters)
+    dir = joinpath(OUTDIR, "checkpoint_y" * lpad(year, 4, '0'))
+    tmp = dir * ".tmp"
+    mkpath(tmp)
+    write_heads(joinpath(tmp, "heads.nc"), h)
+    serialize(joinpath(tmp, "mgv_state.jls"), mgv_state(vic))
+    serialize(joinpath(tmp, "coupling.jls"), Dict("baseflow" => Array(c.baseflow), "cpr" => Array(c.cpr),
+        "requested_cell" => Array(c.requested_cell), "applied_cell" => Array(c.applied_cell),
+        "created_cell" => Array(c.created_cell), "counters" => counters))
+    open(io -> TOML.print(io, Dict("years" => year, "written" => string(now()))), joinpath(tmp, "meta.toml"), "w")
+    mv(tmp, dir; force = true)
+    old = sort(filter(d -> startswith(d, "checkpoint_y") && !endswith(d, ".tmp"), readdir(OUTDIR)))
+    for d in old[1:(end - KEEP)]
+        rm(joinpath(OUTDIR, d); recursive = true)
+    end
+    sz = sum(filesize(joinpath(dir, f)) for f in readdir(dir))
+    println("checkpoint $dir written ($(round(sz / 2^30; digits = 2)) GiB)"); flush(stdout)
+    return dir
+end
+
+function read_checkpoint(dir)
+    meta = TOML.parsefile(joinpath(dir, "meta.toml"))
+    return meta["years"], read_heads(joinpath(dir, "heads.nc")), deserialize(joinpath(dir, "mgv_state.jls")),
+        deserialize(joinpath(dir, "coupling.jls"))
+end
+
+# ------------------------------------------------------------------------------------
+# Start
+# ------------------------------------------------------------------------------------
+mark!("start")
+years_done, heads, mgv_st, coupling_st = if isempty(RESUME)
+    0, copy(STATIC.steady_head), nothing, nothing
+else
+    read_checkpoint(abspath(RESUME))
+end
+println("starting after $years_done years", isempty(RESUME) ? " (provided steady head, CHD ring at 0 m)" : " (checkpoint $RESUME)")
+let failed = [n for (n, ok) in audit_static_inputs(STATIC, build_parameters(STATIC, BASE), BASE) if !ok]
+    isempty(failed) || error("static input audit failed (before mGV's initialisation): ", join(failed, "; "))
+end
+mkpath(normpath(dirname(MGV_CONFIG), TOML.parsefile(MGV_CONFIG)["output"]["dir"]))   # mGV needs it, even without outputs
+t = @elapsed vic = BMI.initialize(mGV.Model, MGV_CONFIG)
+SUMMARY["mgv_init_s"] = t
+println("mGV initialised in $(round(t; digits = 1)) s: $(length(vic.domain.cells)) cells"); flush(stdout)
+mgv_st === nothing || restore_mgv_state!(vic, mgv_st)
+mark!("mgv")
+const R = vic.routing
+const BACKEND = mgv_backend(vic)
+
+"Build the MODFLOW model of `n` years (or days) from heads `h` and its coupling; carry the feedback over from `old`."
+function build(h, n; days = false, old = nothing, st = nothing)
+    t = @elapsed gw = GroundwaterModel(model_config(n; days), inputs_with(h))
+    c = Coupling(gw, vic; exchange = :device, limit_river_loss = LIMIT)
+    src = old !== nothing ? Dict("baseflow" => old.baseflow, "cpr" => old.cpr, "requested_cell" => old.requested_cell,
+                                 "applied_cell" => old.applied_cell, "created_cell" => old.created_cell) : st
+    if src !== nothing
+        for f in ("baseflow", "cpr", "requested_cell", "applied_cell", "created_cell")
+            copyto!(getfield(c, Symbol(f)), src[f])
+        end
+    end
+    println("MODFLOW model of $n $(days ? "days" : "years") built in $(round(t; digits = 1)) s"); flush(stdout)
+    return gw, c
+end
+
+# ------------------------------------------------------------------------------------
+# One coupled day (step_day_device! of coupling.jl, timed per model) and its diagnostics
+# ------------------------------------------------------------------------------------
+const NAN_COUNT = Ref(0)
+budget_terms(gw) = Dict(t.name => (t.rate_in, t.rate_out) for t in last(gw.mf.budgets).terms)
+rate(b, name, which) = haskey(b, name) ? b[name][which] : 0.0
+
+function coupled_day!(c, gw)
+    n = c.n_vic
+    t0 = time_ns()
+    w = BMI.get_value_ptr(vic, "soil__moisture")
+    wmax = BMI.get_value_ptr(vic, "soil__moisture~maximum")
+    add_capillary_rise_kernel!(BACKEND)(w, wmax, c.cpr, n, length(w) ÷ n; ndrange = n)
+    area = BMI.get_value_ptr(vic, "channel_water__area~cross-sectional")
+    q = BMI.get_value_ptr(vic, "channel_water__volume_flow_rate")
+    add_baseflow_kernel!(BACKEND)(area, q, c.requested_cell, c.applied_cell, c.created_cell, c.baseflow, c.cell_length, c.alpha, c.dt; ndrange = n)
+    BMI.update(vic)
+    sync()
+    t1 = time_ns()
+    set_value_device!(gw, "river_discharge", q; map = c.dev_vic_to_mf)
+    set_value_device!(gw, "groundwater_recharge", BMI.get_value_ptr(vic, "land_subsurface__runoff"); map = c.dev_vic_to_mf, divisor = 1000)
+    channel_volume_kernel!(BACKEND)(c.volume, area, c.cell_length; ndrange = n)
+    LIMIT && set_value_device!(gw, "river_water_volume", c.volume; map = c.dev_vic_to_mf)
+    BMI.update(gw)
+    get_value_device!(c.baseflow, gw, "baseflow_to_routing"; map = c.dev_mf_to_vic)
+    get_value_device!(c.cpr, gw, "capillary_rise"; map = c.dev_mf_to_vic)
+    sync()
+    t2 = time_ns()
+    # diagnostics (device reductions; not timed)
+    nonfinite = count(!isfinite, q)
+    qmax = mapreduce(x -> isfinite(x) ? x : -Inf32, max, q)
+    storage = sum(x -> Float64(x), c.volume)   # m3 in the channels after mGV's day
+    created = sum(c.created_cell)
+    r = last(gw.mf.results).outer
+    b = budget_terms(gw)
+    return (; t_mgv = (t1 - t0) / 1e9, t_mf = (t2 - t1) / 1e9, nonfinite, qmax, storage, created,
+            outer = r.iterations, inner = r.inner, b)
+end
+
+const DAY_COLS = ["day", "year", "doy", "t_mgv_s", "t_mf_s", "outer", "inner", "q_max_m3s", "q_nonfinite",
+                  "channel_storage_m3", "created_cum_m3", "rch_in", "riv_in", "riv_out", "drn_out", "evt_out",
+                  "chd_in", "chd_out", "sto_in", "sto_out"]
+function day_row(day, year, doy, d)
+    b = d.b
+    sto_in = rate(b, "STO-SS", 1) + rate(b, "STO-SY", 1)
+    sto_out = rate(b, "STO-SS", 2) + rate(b, "STO-SY", 2)
+    return (day, year, doy, d.t_mgv, d.t_mf, d.outer, d.inner, d.qmax, d.nonfinite, d.storage, d.created,
+            rate(b, "RCH", 1), rate(b, "RIV", 1), rate(b, "RIV", 2), rate(b, "DRN", 2), rate(b, "EVT", 2),
+            rate(b, "CHD", 1), rate(b, "CHD", 2), sto_in, sto_out)
+end
+
+"Change of the heads over a year per layer on the land cells: mean |Δh|, mean Δh, p99 |Δh|, max |Δh|."
+function head_change(h, h0)
+    map(1:2) do l
+        d = filter(isfinite, (view(h, :, :, l) .- view(h0, :, :, l))[ACTIVE])
+        a = abs.(d)
+        (mean(a), mean(d), quantile(a, 0.99), maximum(a))
+    end
+end
+
+const YEAR_COLS = ["year", "wall_s", "dh1_mean_abs", "dh1_mean", "dh1_p99", "dh1_max", "dh2_mean_abs", "dh2_mean", "dh2_p99",
+                   "dh2_max", "baseflow_m3d", "river_loss_m3d", "net_exchange_m3d", "recharge_m3d", "capillary_m3d",
+                   "chd_net_out_m3d", "storage_change_m3", "channel_storage_end_m3", "created_m3", "outer_mean",
+                   "inner_mean", "outer_max", "q_max_m3s", "baseflow_rel_change"]
+
+# ------------------------------------------------------------------------------------
+# Spin-up
+# ------------------------------------------------------------------------------------
+function spinup()
+    days_io = open(joinpath(OUTDIR, "days.csv"), isempty(RESUME) ? "w" : "a")
+    years_io = open(joinpath(OUTDIR, "years.csv"), isempty(RESUME) ? "w" : "a")
+    if isempty(RESUME)
+        println(days_io, join(DAY_COLS, ","))
+        println(years_io, join(YEAR_COLS, ","))
+    end
+    year = years_done
+    h = heads
+    gw, c = build(h, min(SEGMENT, YEARS - year); st = coupling_st)
+    seg_end = year + min(SEGMENT, YEARS - year)
+    mark!("built")
+    counters = coupling_st === nothing ? Dict("streak" => 0, "baseflow_prev" => NaN, "created_prev" => 0.0) : coupling_st["counters"]
+    stop = :years
+    while year < YEARS
+        year += 1
+        t_year = time()
+        rows = []
+        for doy in 1:365
+            d = coupled_day!(c, gw)
+            push!(rows, day_row(365 * (year - 1) + doy, year, doy, d))
+            println(days_io, join(rows[end], ","))
+            if d.nonfinite > 0 || d.qmax > QMAX
+                flush(days_io)
+                error("year $year day $doy: mGV discharge not plausible (max $(d.qmax) m3/s, $(d.nonfinite) non-finite cells)")
+            end
+        end
+        flush(days_io)
+        restart_forcing_year!(vic)
+        h_new = copy(MC.host_field(gw, :head))
+        dh = head_change(h_new, h)
+        h = h_new
+        col(k) = [r[findfirst(==(k), DAY_COLS)] for r in rows]
+        bf = mean(col("riv_out") .+ col("drn_out"))        # m3/day groundwater to rivers
+        loss = mean(col("riv_in"))
+        created = rows[end][findfirst(==("created_cum_m3"), DAY_COLS)]
+        rel = (bf - counters["baseflow_prev"]) / bf
+        counters["baseflow_prev"] = bf
+        sto = sum(col("sto_out") .- col("sto_in"))
+        crit = abs(dh[1][1]) < CRIT_DH && dh[1][3] < CRIT_P99 && abs(rel) < CRIT_BF && abs(sto) < CRIT_STO * sum(col("rch_in"))
+        counters["streak"] = crit ? counters["streak"] + 1 : 0
+        yrow = (year, time() - t_year, dh[1]..., dh[2]..., bf, loss, bf - loss, mean(col("rch_in")), mean(col("evt_out")),
+                mean(col("chd_out") .- col("chd_in")), sum(col("sto_out") .- col("sto_in")),
+                rows[end][findfirst(==("channel_storage_m3"), DAY_COLS)], created - counters["created_prev"],
+                mean(col("outer")), mean(col("inner")), maximum(col("outer")), maximum(col("q_max_m3s")), rel)
+        counters["created_prev"] = created
+        println(years_io, join(yrow, ","))
+        flush(years_io)
+        @printf("year %d: %.0f s, layer 1 |dh| mean %.4f m (mean %+.4f), p99 %.3f, max %.2f; layer 2 |dh| mean %.4f; baseflow %.4g m3/d (%+.2e), loss %.4g, storage change %.4g m3, channels %.4g m3, created %.3g m3, outer %.2f inner %.1f, criterion %s (%d/%d)\n",
+                year, yrow[2], dh[1][1], dh[1][2], dh[1][3], dh[1][4], dh[2][1], bf, rel, loss, yrow[17], yrow[18], yrow[19],
+                yrow[20], yrow[21], crit, counters["streak"], WINDOW)
+        flush(stdout)
+        done = counters["streak"] >= WINDOW
+        done && (stop = :criterion)
+        if year == seg_end || done || year == YEARS
+            write_checkpoint(year, h, vic, c, counters)
+            mark!("year$year")
+            SUMMARY["years_done"] = year
+            write_summary()
+            (done || year == YEARS) && break
+            n = min(SEGMENT, YEARS - year)
+            old = c
+            BMI.finalize(gw)
+            gw = nothing; GC.gc(true)
+            gw, c = build(h, n; old)
+            old = nothing; GC.gc(true)
+            seg_end = year + n
+        end
+    end
+    SUMMARY["stop"] = string(stop)
+    SUMMARY["years_done"] = year
+    write_heads(joinpath(OUTDIR, "heads_final.nc"), h)
+    BMI.finalize(gw)
+    close(days_io); close(years_io)
+    println("spin-up stopped after $year years: ", stop === :criterion ? "criterion met for $WINDOW years" : "year limit")
+    return
+end
+
+# ------------------------------------------------------------------------------------
+# Daily run from a checkpoint (timing)
+# ------------------------------------------------------------------------------------
+function daily()
+    gw, c = build(heads, DAYS; days = true, st = coupling_st)
+    mark!("built")
+    io = open(joinpath(OUTDIR, "days.csv"), "w")
+    println(io, join(DAY_COLS, ","))
+    rows = []
+    t = @elapsed for day in 1:DAYS
