+# Global 5 arcmin MODFLOW model of the coupled run (ModflowGPU T5.5b), north of 60N masked
+# out (PLAN.md decision 10; derived files of make_60N_inputs.jl), with the other input
+# file choices of the T5.5a input checks (examples/global/README.md; run
+# `check_inputs.jl` to repeat them). Paths are those of the machine the checks ran on.
+# Relative paths are resolved against this file's directory.
+model_name = "GLOBAL"
+
+[paths]
+data_dir = "/home/bart/data/modflow/global_data"
+work_dir = "../../run/global_60N/mf6"
+output_dir = "../../run/global_60N/output"
+# No coupled steady state yet: T5.5b computes the first one (steady-state spin-up,
+# period = "steady"). Until then the initial head is inputs.steady_head.
+
+[time]
+start_date = 1979-01-01
+end_date = 1979-12-31
+period = "day"   # the mGV coupling exchanges daily
+
+[coupling]
+foc = true       # EVT package + capillary-rise feedback
+pumping = false
+
+[output]
+write_monthly = false
+save_mf6_binary = false
+
+[audit]
+orientation = true
+
+[solver]
+engine = "gpu"   # the mf6 engine would need about 2 GB of MF6 input files and runs serially
+# backend, precision, preconditioner, coupling: "auto" (rocm, :mixed, mc_ilu0, device)
+# outer_dvclose = inner_dvclose = 0.01 (the GPU engine default, ModflowGPU decision 9)
+
+# Static inputs, relative to data_dir. All files are on the 4320 x 1680 grid of the mGV
+# parameter file (84 N to 56 S, latitude ascending in every file; checked by
+# check_inputs.jl). The `_nogl` domain (VIC active domain without Greenland,
+# coupled_domain_rebuild.qa.json) and the files rebuilt on it are used throughout.
+[inputs]
+ibound = "/home/bart/data/mGV/global_60N/modflow/ibound_oc_nogl_60N.nc"   # idomain 0 north of 60N (no-flow at the cut)
+landmask = "/home/bart/data/mGV/global_60N/modflow/landmask_oc_nogl_60N.nc"
+dem = "dem_ini_oc.nc"
+aqdepth = "aqdepth_ini_oc.nc"
+cell_area = "cell_area_oc.nc"
+ksat_log = "ksat_log_oc.nc"
+ksat_l1_conf_log = "ksat_l1_conf_log_oc.nc"
+ksat_l2_conf_log = "ksat_l2_conf_log_oc.nc"
+spe_yi = "spe_yi_inp_oc.nc"
+qbank = "qbank_daily_1979_2019_natpcv_gwm_v1.nc"
+riv_slope = "riv_slope_oc.nc"
+min_dem = "min_dem_oc_v2clamped.nc"
+z0_floodplain = "Z0_floodplain_oc_v2clamped.nc"
+kq3 = "KQ3_oc.nc"
+catchment = "ldd_oc_nogl.nc"   # catchment ids, not flow directions (as ldd_indus_updated.nc)
+# v2, not v3: v3's `cprate` is the physical rate times cell_area / (DELR * DELC), and
+# ModflowCoupling applies that factor itself (evt_parameters), so v3 would apply it twice.
+cpsurface = { file = "capillary_rise_oc_v2.nc", variable = "cpsurface" }
+cprate = { file = "capillary_rise_oc_v2.nc", variable = "cprate" }
+cpdistinct = { file = "capillary_rise_oc_v2.nc", variable = "cpdistinct" }
+# the provided steady head with sea level (0 m) on the CHD ring, which it has no head on
+steady_head = "/home/bart/data/mGV/global_60N/modflow/initial_head_gv2p41_5min_nogl_chd0_60N.nc"
diff --git a/examples/global/make_60N_inputs.jl b/examples/global/make_60N_inputs.jl
new file mode 100644
index 0000000..975179f
--- /dev/null
+++ b/examples/global/make_60N_inputs.jl
@@ -0,0 +1,141 @@
+#= Derived inputs of the global coupled run with everything north of 60°N masked out
+(ModflowGPU T5.5b, PLAN.md decision 10). Writes into `outdir` (new files only; the
+originals are not changed):
+
+- `vic_global_5min_params_lossless_60N.nc`: mGV's parameter file with `run_cell` = 0 on
+  every cell whose centre lies north of 60°N. mGV restricts its routing to the active
+  cells itself (cells that flow into a removed cell become outlets, `RoutingState`), and
+  reads only the active rows of the land-only forcing, so the routing and forcing files
+  are used as they are.
+- `modflow/ibound_oc_nogl_60N.nc`, `modflow/landmask_oc_nogl_60N.nc`: idomain and land
+  mask 0 north of 60°N (no-flow at the cut).
+- `modflow/initial_head_gv2p41_5min_nogl_chd0_60N.nc`: the provided steady head with sea
+  level (0 m) on the CHD ring cells (it has no head there) and NaN north of 60°N.
+
+Also prints the mask counts, the routing links cut, the shortest remaining channel and the
+DEM check of the CHD heads (coastal land cells against sea level).
+
+    julia --project=examples/mgv_coupling examples/global/make_60N_inputs.jl <outdir>
+=#
+using NCDatasets, Statistics, Printf
+
+const LATMAX = 60.0
+const MF = "/home/bart/data/modflow/global_data"
+const PARAMS = "/home/bart/data/mGV/vic_global_5min_params_lossless.nc"
+const ROUTING = "/home/bart/data/mGV/routing/routing_global_5min.nc"
+outdir = abspath(ARGS[1])
+mkpath(joinpath(outdir, "modflow"))
+
+# New copy of `src` in `dst` (never overwrites), then `f(ds)` on it in append mode.
+function derive(f, src, dst)
+    isfile(dst) && error("$dst exists; remove it first")
+    cp(src, dst)
+    chmod(dst, 0o644)
+    NCDataset(f, dst, "a")
+    return dst
+end
+
+# ---------------------------------------------------------------- mGV parameters
+lat_p, run_cell = NCDataset(PARAMS) do ds
+    Float64.(ds["lat"][:]), ds["run_cell"][:, :]
+end
+# NCDatasets reads (lon, lat)
+north_p = repeat(reshape(lat_p .> LATMAX, 1, :), size(run_cell, 1), 1)
+active0 = coalesce.(run_cell, 0) .> 0
+@printf("mGV: %d active cells, %d north of %.0fN (removed), %d remain\n",
+        count(active0), count(active0 .& north_p), LATMAX, count(active0 .& .!north_p))
+derive(PARAMS, joinpath(outdir, "vic_global_5min_params_lossless_60N.nc")) do ds
+    v = ds["run_cell"]
+    x = v[:, :]
+    x[north_p] .= 0
+    v[:, :] = x
+    ds.attrib["history_60N"] = "run_cell = 0 north of $(LATMAX)N (ModflowGPU T5.5b, examples/global/make_60N_inputs.jl of the patched ModflowCoupling)"
+end
+active = active0 .& .!north_p
+
+# ---------------------------------------------------------------- routing links and channels
+ids, target, dist, carea, lat_r = NCDataset(ROUTING) do ds
+    coalesce.(ds["downstream_id"][:, :], -1), coalesce.(ds["downstream"][:, :], -1),
+    Float32.(coalesce.(ds["cell_dist"][:, :], NaN32)), Float32.(coalesce.(ds["cell_area"][:, :], NaN32)),
+    Float64.(ds["lat"][:])
+end
+maximum(abs.(lat_r .- lat_p)) < 1e-3 || error("routing and parameter latitudes differ")
+id_to_index = Dict(ids[i] => i for i in eachindex(ids) if ids[i] != -1)
+down = [t != -1 && haskey(id_to_index, t) && id_to_index[t] != i ? id_to_index[t] : 0 for (i, t) in enumerate(target)]
+north_out = count(i -> active[i] && down[i] > 0 && active0[down[i]] && north_p[down[i]], eachindex(down))
+south_in = count(i -> active0[i] && north_p[i] && down[i] > 0 && active[down[i]], eachindex(down))
+@printf("routing: %d links from south of %.0fN into removed cells (new outlets), %d links from removed cells into the remaining domain (inflow lost)\n",
+        north_out, LATMAX, south_in)
+# channel length as mGV sets it (RoutingState): cell_dist, or sqrt(cell_area) where not positive and finite
+len(i) = (dist[i] > 0 && isfinite(dist[i])) ? dist[i] : sqrt(carea[i])
+for (name, m) in (("all active (before the mask)", active0), ("south of 60N", active))
+    l = [len(i) for i in findall(vec(m))]
+    @printf("channel length, %s: min %.0f m, cells < 3600 m: %d, < 4639 m: %d\n", name, minimum(l), count(<(3600), l), count(<(4639), l))
+end
+
+# ---------------------------------------------------------------- MODFLOW
+ibound, lat_m = NCDataset(joinpath(MF, "ibound_oc_nogl.nc")) do ds
+    coalesce.(ds["ibound"][:, :], NaN), Float64.(ds["lat"][:])
+end
+north_m = repeat(reshape(lat_m .> LATMAX, 1, :), size(ibound, 1), 1)
+for (k, name) in ((1, "land"), (2, "CHD"))
+    @printf("MODFLOW: idomain %d (%s): %d cells, %d north of %.0fN (removed)\n", k, name, count(==(k), ibound), count((ibound .== k) .& north_m), LATMAX)
+end
+derive(joinpath(MF, "ibound_oc_nogl.nc"), joinpath(outdir, "modflow", "ibound_oc_nogl_60N.nc")) do ds
+    x = ds["ibound"][:, :]
+    x[north_m] .= 0
+    ds["ibound"][:, :] = x
+    ds.attrib["history_60N"] = "ibound = 0 north of $(LATMAX)N (ModflowGPU T5.5b)"
+end
+derive(joinpath(MF, "landmask_oc_nogl.nc"), joinpath(outdir, "modflow", "landmask_oc_nogl_60N.nc")) do ds
+    name = only(k for k in keys(ds) if !(k in ("lat", "lon")))
+    x = ds[name][:, :]
+    x[north_m] .= 0
+    ds[name][:, :] = x
+    ds.attrib["history_60N"] = "$name = 0 north of $(LATMAX)N (ModflowGPU T5.5b)"
+end
+chd = (ibound .== 2) .& .!north_m
+derive(joinpath(MF, "initial_head_gv2p41_5min_nogl.nc"), joinpath(outdir, "modflow", "initial_head_gv2p41_5min_nogl_chd0_60N.nc")) do ds
+    lat_h = Float64.(ds["latitude"][:])
+    maximum(abs.(lat_h .- lat_m)) < 1e-3 || error("head and ibound latitudes differ")
+    g = ds["gwl"]
+    x = g[:, :, :]    # (lon, lat, layer)
+    @printf("head file: %d CHD cells south of 60N without a head (set to 0 m)\n", count(chd .& isnan.(coalesce.(x[:, :, 1], NaN32))))
+    for l in 1:2
+        xl = view(x, :, :, l)
+        xl[chd] .= 0
+        xl[north_m] .= NaN32
+    end
+    g[:, :, :] = x
+    ds.attrib["history_60N"] = "gwl = 0 (sea level) on the CHD ring (ibound 2) and NaN north of $(LATMAX)N (ModflowGPU T5.5b)"
+end
+
+# ---------------------------------------------------------------- DEM against sea level
+dem = NCDataset(joinpath(MF, "dem_ini_oc.nc")) do ds
+    coalesce.(ds["elev"][:, :], NaN)
+end
+land = (ibound .== 1) .& .!north_m
+nx, ny = size(ibound)
+coast = falses(nx, ny)   # land cells next to a CHD ring cell (8 neighbours, longitude wraps)
+for j in 1:ny, i in 1:nx
+    land[i, j] || continue
+    for dj in -1:1, di in -1:1
+        jj = j + dj
+        1 <= jj <= ny || continue
+        chd[mod1(i + di, nx), jj] && (coast[i, j] = true)
+    end
+end
+d = filter(isfinite, dem[coast])
+@printf("DEM on %d coastal land cells (next to the CHD ring): median %.1f m, p05 %.1f, p25 %.1f, below 0: %d (%.2f %%), below -5 m: %d\n",
+        count(coast), median(d), quantile(d, 0.05), quantile(d, 0.25), count(<(0), d), 100 * count(<(0), d) / length(d), count(<(-5), d))
+dl = filter(isfinite, dem[land])
+@printf("DEM on all %d land cells: min %.1f m, below 0: %d (%.2f %%)\n", count(land), minimum(dl), count(<(0), dl), 100 * count(<(0), dl) / length(dl))
+dc = filter(isfinite, dem[chd])
+@printf("DEM on the %d CHD ring cells (ocean): %d finite, median %s\n", count(chd), length(dc), isempty(dc) ? "-" : @sprintf("%.1f", median(dc)))
+h1 = NCDataset(joinpath(MF, "initial_head_gv2p41_5min_nogl.nc")) do ds
+    coalesce.(ds["gwl"][:, :, 1], NaN32)
+end
+hc = filter(isfinite, Float64.(h1[coast]))
+@printf("provided steady head (layer 1) on the coastal land cells: median %.1f m, below 0: %d (%.2f %%)\n",
+        median(hc), count(<(0), hc), 100 * count(<(0), hc) / length(hc))
+println("done")
