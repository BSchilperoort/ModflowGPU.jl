+# mGV config of the coupled global run of ModflowGPU T5.5b (run_global.jl): as
+# mgv_global.toml, with everything north of 60N masked out (PLAN.md decision 10):
+# - parameters: vic_global_5min_params_lossless_60N.nc (make_60N_inputs.jl: run_cell 0
+#   north of 60N, 1,713,802 active cells; mGV cuts the routing to them itself)
+# - routing: routing_global_5min.nc, made with mGV-input-data's make-routing.py in two
+#   longitude boxes and merged (merge_routing_tiles.py, README.md)
+# - forcing: the land-only WFDE5 v3.1 store of 1979, all seven variables in one store
+#   (`forcing_file`; the per-variable entries default to it, names are mGV's defaults);
+#   run_global.jl cycles this year for the spin-up. mGV `main` (42aebaa) opens the gridded
+#   store /media/bart/Data/Work/SWIFT/WFDE5_v3.1_5arcmin.zarr (one store, all variables,
+#   int16) but its gridded reader ignores scale_factor, add_offset and _FillValue, so it
+#   would read the raw int16 values (T5.5b report).
+start_year = 1979
+end_year = 1979
+
+enable_routing = true
+enable_snow = true
+fillvalue_threshold = 1e15
+
+[output]
+dir         = "../../run/global_60N/mgv"
+file_prefix = "global_"
+format      = "netcdf"
+variables   = []   # none; list mGV output variables to write them
+
+[API]
+# MODFLOW routes the subsurface runoff (required by the coupling, examples/mgv_coupling)
+external_groundwater_routing = true
+
+[input]
+[input.paths]
+input_param_file   = "/home/bart/data/mGV/global_60N/vic_global_5min_params_lossless_60N.nc"   # run_cell 0 north of 60N
+routing_param_file = "/home/bart/data/mGV/routing/routing_global_5min.nc"
+forcing_file       = "/home/bart/data/mGV/WFDE5_v3.1_5arcmin_land_1979.zarr"
+
+[input.names]
diff --git a/examples/global/run_global.jl b/examples/global/run_global.jl
