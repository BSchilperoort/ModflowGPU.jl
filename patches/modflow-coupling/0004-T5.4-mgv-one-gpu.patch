diff --git a/examples/indus/indus.toml b/examples/indus/indus.toml
index eadfd51..f3b0645 100644
--- a/examples/indus/indus.toml
+++ b/examples/indus/indus.toml
@@ -35,6 +35,11 @@ orientation = true
 # precision = "auto"      # gpu engine: "auto" (:mixed with Float64, else :single), "double", "mixed", "single"
 # preconditioner = "auto" # gpu engine: ModflowGPU's default (mc_ilu0), or "jacobi", "amg", ...
 # coupling = "auto"       # gpu engine: "device" (stresses and outputs in kernels on the device; the default) or "host"
+# outer_dvclose and inner_dvclose (m) default per engine:
+# - mf6: 5.0 (the Python reference). MF6 then stops up to 1.9 m from its converged heads
+#   on monthly periods (ModflowGPU T5.3 closure study); set 0.01 for converged heads.
+# - gpu: 0.01 (ModflowGPU decision 9, T5.3/T5.4): within 1.5e-4 m of the tight heads on
+#   daily steps, for 20-40 % more time per period than at 5.
 # outer_dvclose = 5.0
 # inner_dvclose = 5.0
 # inner_rclose = 10.0
