index 0000000..870939a
--- /dev/null
+++ b/src/device_coupling.jl
@@ -0,0 +1,299 @@
+#=
+Device-resident coupling with the GPU engine (`[solver] coupling = "device"`, the default
+of `engine = "gpu"`; ModflowGPU T5.2). `apply_stresses!` and `collect_outputs!` run as
+KernelAbstractions kernels on the engine's own arrays (`ModflowGPU.get_value_ptr(sim,
+address; device = true)`: precision `T`, head-like values as offsets from
+`"<model>/HREF"`), with the record → cell maps on the device, so a stress period moves no
+data between host and device except what a caller asks for on the host:
+
+- inputs set on the host (`BMI.set_value`, the forcing file) are copied to the device in
+  the setter, once per call;
+- outputs (heads, `groundwater_depth`, `baseflow`, `capillary`) are computed on the
+  device by `collect_outputs!`; the host copies of `head`, `baseflow` and `capillary` are
+  refreshed on first access after an update (`GroundwaterModel` fields, `BMI.get_value`,
+  `get_value_ptr`, the monthly output file; the host `groundwater_depth` is derived from
+  the Float64 host heads as before). `BMI.get_value_ptr(model, name; device = true)`
+  returns the device arrays.
+
+Precision (ModflowGPU PLAN.md section 3.7): the river stage is computed in offset form,
+`stage' = (bottom_bankfull − r) + depth`, with the reference `r` of the record's cell
+subtracted on the host in Float64, so a Float32 stage keeps millimetre resolution where
+the absolute stage (hundreds to thousands of metres) would not. The groundwater depth is
+`top' − h'` with `top' = top − r` (host, Float64), not the difference of two absolute
+heads. Absolute heads exist on the host only (`r + h'` in Float64).
+
+The host path (`coupling = "host"`) writes the stresses into ModflowGPU's host mirrors
+(`get_value_ptr` without `device`), as the mf6 engine does with libmf6's arrays.
+=#
+
+"""
+    DeviceCoupling
+
+Device arrays of the device-resident coupling (`coupling = "device"`), in the engine
+precision `T`: the engine arrays (offset heads `h`, BOUND of RCH, RIV and WEL, SIMVALS of
+RIV, DRN and EVT), the input fields (per 2D cell, `ncell = ncol·nrow`), the per-record
+parameters and record → cell maps, the cell → node and cell → record maps of the outputs,
+and the outputs (`head` offsets for both layers, `depth`, `baseflow`, `capillary`). Host
+side: the per-cell references `href` (Float64, NaN without a node) that turn offsets into
+absolute heads, and staging buffers in `T`.
+"""
+struct DeviceCoupling{T, V <: AbstractVector{T}, VI <: AbstractVector{Int32}, VB <: AbstractVector{Bool}, M <: AbstractMatrix{T}}
+    mxiter::Int
+    # engine arrays (ModflowGPU.get_value_ptr(...; device = true))
+    h::V
+    rch_bound::M
+    riv_bound::M
+    wel_bound::M                # (1, 0) without WEL
+    riv_simvals::V
+    drn_simvals::V
+    evt_simvals::V              # empty without EVT
+    # inputs per 2D cell (copied from the host fields by the setters)
+    recharge::V
+    discharge::V
+    abstraction::V
+    # RCH records: cell, area factor
+    rch_cell::VI
+    rch_factor::V
+    # RIV records: cell, kind, Manning denominator, offsets of the stage levels
+    riv_cell::VI
+    riv_is_river::VB
+    riv_denom::V                # width · sqrt(slope), NaN without a usable slope
+    riv_bankfull::V             # bottom_bankfull − r
+    riv_ini::V                  # head_ini − r
+    riv_bottom::V               # bottom − r
+    # WEL records: cell
+    wel_cell::VI
+    # output maps per user cell
+    head_node::VI               # (2·ncell): reduced node, 0 without one (idomain <= 0)
+    riv_rec::VI                 # (ncell): RIV record of the cell, 0 without one
+    drn_rec::VI
+    evt_rec::VI
+    land::VB
+    area::V                     # true cell area (m2)
+    top_offset::V               # top − r of the layer-1 node (NaN without one)
+    # outputs
+    head::V                     # (2·ncell) offsets from href, NaN without a node
+    depth::V                    # (ncell) top' − h' of layer 1 on land, NaN elsewhere
+    baseflow::V                 # (ncell) m3/s, NaN off land
+    capillary::V                # (ncell) mm per stress period
+    # host side
+    href::Vector{Float64}       # (2·ncell) reference head per user cell, NaN without a node
+    staging::Vector{T}          # (ncell) input upload buffer
+    head_host::Vector{T}        # (2·ncell) output download buffers
+    field_host::Vector{T}       # (ncell)
+end
+
+"Copy host array `x` to a new device array on `backend`."
+function to_device(backend, x::AbstractArray)
+    d = KernelAbstractions.allocate(backend, eltype(x), size(x))
+    isempty(x) || copyto!(d, x)
+    return d
+end
+
+"""
+    DeviceCoupling(m::GroundwaterModel, sim::ModflowGPU.Simulation)
+
+Set up the device-resident coupling of `m` on the engine `sim` (after `initialize`):
+engine arrays, maps and per-record parameters (host Float64, cast to `sim.T` once).
+Reads host values through `ModflowGPU.get_value` (copies) only, so the engine keeps no
+host mirrors to synchronise.
+"""
+function DeviceCoupling(m, sim::ModflowGPU.Simulation)
+    G = ModflowGPU
+    T = sim.T
+    name = m.config.model_name
+    dptr(var, sub = "") = G.get_value_ptr(sim, join(filter(!isempty, [name, sub, var]), "/"); device = true)
+    value(var, sub = "") = G.get_value(sim, join(filter(!isempty, [name, sub, var]), "/"))
+    h = dptr("X")
+    backend = KernelAbstractions.get_backend(h)
+    dev(x) = to_device(backend, x)
+    p, s = m.params, m.inputs
+    lin = LinearIndices(s.idomain)
+    ncell = length(s.idomain)
+
+    # reduced node of each user cell (as `collect_outputs!` of the host path: NaN where
+    # idomain <= 0), and the reference of each node
+    href_node = value("HREF")
+    nodeuser = Int.(value("NODEUSER", "DIS"))
+    nodes = length(href_node)
+    length(nodeuser) == nodes || (nodeuser = collect(1:nodes))   # no inactive cells (MF6's dummy array)
+    head_node = zeros(Int32, 2ncell)
+    for (n, u) in enumerate(nodeuser)
+        s.idomain[mod1(u, ncell)] > 0 && (head_node[u] = n)
+    end
+    href = [n > 0 ? href_node[n] : NaN for n in head_node]
+    r_cell(c) = href[lin[c]]   # reference of the layer-1 node of 2D cell c
+
+    rec_map(cells) = (map = zeros(Int32, ncell); for (i, c) in enumerate(cells); map[lin[c]] = i; end; map)
+    cell_index(cells) = Int32[lin[c] for c in cells]
+    r = p.river
+    rr = r_cell.(r.cells)
+    any(isnan, rr) && error("RIV records on cells without a node")
+    top_offset = [n > 0 ? p.top[c] - href_node[n] : NaN for (c, n) in zip(CartesianIndices(s.idomain), view(head_node, 1:ncell))]
+
+    evt = m.config.foc ? dptr("SIMVALS", "EVT") : similar(h, 0)
+    wel = m.config.pumping ? dptr("BOUND", "WEL") : similar(h, 1, 0)
+    return DeviceCoupling(
+        Int(only(G.get_value(sim, "SLN_1/MXITER"))),
+        h, dptr("BOUND", "RCH"), dptr("BOUND", "RIV"), wel,
+        dptr("SIMVALS", "RIV"), dptr("SIMVALS", "DRN"), evt,
+        dev(zeros(T, ncell)), dev(zeros(T, ncell)), dev(zeros(T, ncell)),
+        dev(cell_index(p.rch_cells)), dev(T.(p.area_factor[p.rch_cells])),
+        dev(cell_index(r.cells)), dev(Vector{Bool}(r.is_river)), dev(T.(r.width .* sqrt.(r.slope))),
+        dev(T.(r.bottom_bankfull .- rr)), dev(T.(r.head_ini .- rr)), dev(T.(r.bottom .- rr)),
+        dev(cell_index(m.config.pumping ? p.wel_cells : CartesianIndex{2}[])),
+        dev(head_node), dev(rec_map(r.cells)), dev(rec_map(p.drain.cells)),
+        dev(rec_map(m.config.foc ? p.evt_cells : CartesianIndex{2}[])),
+        dev(Vector{Bool}(vec(s.landmask))), dev(T.(vec(s.cell_area))), dev(T.(top_offset)),
+        dev(fill(T(NaN), 2ncell)), dev(fill(T(NaN), ncell)), dev(fill(T(NaN), ncell)), dev(zeros(T, ncell)),
+        href, zeros(T, ncell), zeros(T, 2ncell), zeros(T, ncell),
+    )
+end
+
+"Copy the host input field `x` (Float64, finite) into the device array `d` (through the staging buffer)."
+function upload_input!(d::DeviceCoupling, dest, x::AbstractArray)
+    d.staging .= vec(x)
+    copyto!(dest, d.staging)
+    return dest
+end
+
+# ------------------------------------------------------------------------------------
+# apply_stresses!: BOUND of RCH, RIV and WEL from the input fields
+# ------------------------------------------------------------------------------------
+
+# RCH (`apply_stresses!` of the host path): rate = max(0, recharge · area_factor), per
+# unit area (the GPU engine's RCH scale is 1).
+@kernel function recharge_bound_kernel!(bound, @Const(recharge), @Const(cell), @Const(factor))
+    i = @index(Global)
+    @inbounds bound[1, i] = max(zero(eltype(bound)), recharge[cell[i]] * factor[i])
+end
+
+# RIV stage as an offset from the record's reference (`river_stage` in offset form).
+@kernel function river_stage_kernel!(
+        bound, @Const(discharge), @Const(cell), @Const(is_river), @Const(denom),
+        @Const(bankfull), @Const(ini), @Const(bottom), manning, expo,
+    )
+    i = @index(Global)
+    @inbounds begin
+        q = discharge[cell[i]]
+        T = eltype(bound)
+        if q < zero(T)
+            stage = bottom[i]                 # no river infiltration
+        elseif !is_river[i]
+            stage = ini[i]
+        else
+            x = manning * q / denom[i]
+            depth = x >= zero(T) ? x^expo : T(NaN)   # NaN without a usable slope
+            depth = (isnan(depth) || depth < T(0.01)) ? zero(T) : depth
+            stage = bankfull[i] + depth
+            isnan(stage) && (stage = ini[i])
+        end
+        bound[1, i] = stage
+    end
+end
+
+# WEL: q = −abstraction.
+@kernel function well_bound_kernel!(bound, @Const(abstraction), @Const(cell))
+    i = @index(Global)
+    @inbounds bound[1, i] = -abstraction[cell[i]]
+end
+
+"""
+    apply_stresses_device!(d::DeviceCoupling)
+
+`apply_stresses!` on the device: write the RCH rates, the RIV stages (offsets) and the
+WEL rates of the input fields into the engine's device BOUND arrays.
+"""
+function apply_stresses_device!(d::DeviceCoupling{T}) where {T}
+    backend = KernelAbstractions.get_backend(d.h)
+    n = length(d.rch_cell)
+    n > 0 && recharge_bound_kernel!(backend)(d.rch_bound, d.recharge, d.rch_cell, d.rch_factor; ndrange = n)
+    n = length(d.riv_cell)
+    n > 0 && river_stage_kernel!(backend)(
+        d.riv_bound, d.discharge, d.riv_cell, d.riv_is_river, d.riv_denom, d.riv_bankfull, d.riv_ini, d.riv_bottom,
+        T(RIV_MANNING), T(3 / 5); ndrange = n,
+    )
+    n = length(d.wel_cell)
+    n > 0 && well_bound_kernel!(backend)(d.wel_bound, d.abstraction, d.wel_cell; ndrange = n)
+    return d
+end
+
+# ------------------------------------------------------------------------------------
+# collect_outputs!: heads, groundwater depth, baseflow and capillary rise
+# ------------------------------------------------------------------------------------
+
+# Offset head per user cell of both layers (NaN without a node).
+@kernel function head_output_kernel!(head, @Const(h), @Const(node))
+    u = @index(Global)
+    @inbounds begin
+        n = node[u]
+        head[u] = n > 0 ? h[n] : eltype(head)(NaN)
+    end
+end
+
+# Per 2D cell: baseflow_to_routing = −(RIV + DRN)/86400 (m3/s; |x| > 1e8 → 0; NaN off
+# land), capillary rise = −EVT · days / area · 1000 (mm per period), groundwater depth
+# top' − h' of layer 1 (NaN off land or without a node). As `collect_outputs!` of the
+# host path, in the same order of operations.
+@kernel function flux_output_kernel!(
+        baseflow, capillary, depth, @Const(riv), @Const(drn), @Const(evt),
+        @Const(riv_rec), @Const(drn_rec), @Const(evt_rec), @Const(land), @Const(area),
+        @Const(top_offset), @Const(h), @Const(node), spd, days,
+    )
+    c = @index(Global)
+    @inbounds begin
+        T = eltype(baseflow)
+        bf = zero(T)
+        ir = riv_rec[c]
+        ir > 0 && (bf = -riv[ir] / spd)
+        id = drn_rec[c]
+        id > 0 && (bf -= drn[id] / spd)
+        abs(bf) > T(1.0e8) && (bf = zero(T))
+        baseflow[c] = land[c] ? bf : T(NaN)
+        ie = evt_rec[c]
+        capillary[c] = ie > 0 ? -evt[ie] * days / area[c] * T(1000) : zero(T)
+        n = node[c]
+        depth[c] = (land[c] && n > 0) ? top_offset[c] - h[n] : T(NaN)
+    end
+end
+
+"""
+    collect_outputs_device!(d::DeviceCoupling, days)
+
+`collect_outputs!` on the device, from the engine's offset heads and SIMVALS: the head
+offsets of both layers, the groundwater depth, baseflow and capillary rise (`days`: the
+length of the completed stress period).
+"""
+function collect_outputs_device!(d::DeviceCoupling{T}, days::Real) where {T}
+    backend = KernelAbstractions.get_backend(d.h)
+    head_output_kernel!(backend)(d.head, d.h, d.head_node; ndrange = length(d.head))
+    evt = isempty(d.evt_simvals) ? d.riv_simvals : d.evt_simvals   # evt_rec is all 0 without EVT
+    flux_output_kernel!(backend)(
+        d.baseflow, d.capillary, d.depth, d.riv_simvals, d.drn_simvals, evt,
+        d.riv_rec, d.drn_rec, d.evt_rec, d.land, d.area, d.top_offset, d.h, d.head_node,
+        T(SECONDS_PER_DAY), T(days); ndrange = length(d.baseflow),
+    )
+    return d
+end
+
+"""
+    sync_output!(m, field)
+
+Refresh the host copy of output `field` (`:head`, `:baseflow` or `:capillary`)
+from the device, if it changed since it was last copied (the device-resident coupling).
+Heads become absolute (`href + h'`, Float64).
+"""
+function sync_output!(m, field::Symbol)
+    stale = getfield(m, :host_stale)
+    field in stale || return nothing
+    d = getfield(m, :dev)
+    if field === :head
+        copyto!(d.head_host, d.head)
+        getfield(m, :head) .= reshape(d.href .+ Float64.(d.head_host), size(getfield(m, :head)))
+    else
+        copyto!(d.field_host, getfield(d, field))
+        getfield(m, field) .= reshape(d.field_host, size(getfield(m, field)))
+    end
+    delete!(stale, field)
+    return nothing
+end
