-BMI.get_value_ptr(m::GroundwaterModel, name::String) = vec(var_array(m, name))
+"""
+    BMI.get_value_ptr(m::GroundwaterModel, name; device = false)
+
+The host array of variable `name` (Float64, flattened). With the device-resident
+coupling, an output's host array is refreshed from the device by this call (and by
+`get_value`), not by `update`: call it again after each update.
+
+With `device = true` (device-resident coupling only): the device array that the coupling
+kernels use, in the engine precision `T` (`m.mf.T`), flattened per 2D cell (both layers
+for `groundwater_head`). Heads (`groundwater_head`, `groundwater_head_layer_1`/`_2`) are
+offsets from `head_reference(m)` (absolute = reference + offset, in Float64 on the host);
+`groundwater_depth`, `baseflow_to_routing` and `capillary_rise` are in their BMI units.
+The inputs are the values last set on the host. Read only: writes are overwritten by the
+next update (inputs: by the next `set_value`).
+"""
+function BMI.get_value_ptr(m::GroundwaterModel, name::String; device::Bool = false)
+    device || return vec(var_array(m, name))
+    device_coupling(m) || error("get_value_ptr(...; device = true) needs the GPU engine with coupling = \"device\"")
+    d, n = m.dev, length(m.recharge)
+    name == "groundwater_recharge" && return d.recharge
+    name == "river_discharge" && return d.discharge
+    name == "groundwater_abstraction" && return d.abstraction
+    name == "groundwater_head" && return d.head
+    name == "groundwater_head_layer_1" && return view(d.head, 1:n)
+    name == "groundwater_head_layer_2" && return view(d.head, (n + 1):2n)
+    name == "groundwater_depth" && return d.depth
+    name == "baseflow_to_routing" && return d.baseflow
+    name == "capillary_rise" && return d.capillary
+    error("unknown variable $name")
+end
+
+"""
+    head_reference(m::GroundwaterModel) -> Vector{Float64}
+
+The reference head per user cell of both layers (NaN without an active cell) of the
+device head offsets (`BMI.get_value_ptr(m, "groundwater_head"; device = true)`).
+"""
+head_reference(m::GroundwaterModel) = device_coupling(m) ? copy(m.dev.href) :
+    error("head_reference needs the GPU engine with coupling = \"device\"")
 BMI.get_value(m::GroundwaterModel, name::String, dest) = copyto!(dest, vec(var_array(m, name)))
 BMI.get_value_at_indices(m::GroundwaterModel, name::String, dest, inds) =
     copyto!(dest, vec(var_array(m, name))[inds])
